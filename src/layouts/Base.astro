---
import '../styles/index.css';
import Nav from '../components/Nav.astro';
import type { NavLink, NavAction } from '../components/Nav.astro';

interface Props {
  title: string;
  description?: string | undefined;
  noindex?: boolean;
  /** Header brand text. Omit the nav entirely by passing navLinks: []. */
  brand?: string;
  navLinks?: readonly NavLink[] | undefined;
  navActions?: readonly NavAction[] | undefined;
}

const {
  title,
  description,
  noindex = false,
  brand = 'Adarsh Ambati',
  navLinks,
  navActions,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://adarshambati.com');

/* The header is fixed, so pages without a full-bleed hero need to be pushed
   clear of it. A hero handles its own clearance. */
const hasBleed: boolean = Astro.slots.has('bleed');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical.href} />

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {
      !noindex && (
        <>
          <meta property="og:type" content="website" />
          <meta property="og:title" content={title} />
          {description && <meta property="og:description" content={description} />}
          <meta property="og:url" content={canonical.href} />
          <meta name="twitter:card" content="summary" />
        </>
      )
    }

    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/icon-180.png" />
    <link rel="icon" href="/icons/icon-192.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="theme-color" content="#ffffff" />
  </head>
  <body>
    <Nav
      name={brand}
      {...(navLinks ? { links: navLinks } : {})}
      {...(navActions ? { actions: navActions } : {})}
    />
    <!-- Full-bleed content (the hero) goes here, outside the centred column. -->
    <slot name="bleed" />
    <main class:list={['page', { 'page--offset': !hasBleed }]}>
      <slot />
    </main>
  </body>
</html>

<style>
  .page {
    max-width: var(--width-content);
    margin: 0 auto;
    padding: var(--space-8) var(--space-5) var(--space-9);
  }

  .page--offset {
    padding-top: calc(var(--header-height) + var(--space-7));
  }

  @media (max-width: 30rem) {
    .page {
      padding-top: var(--space-6);
    }
    .page--offset {
      padding-top: calc(var(--header-height) + var(--space-5));
    }
  }
</style>
