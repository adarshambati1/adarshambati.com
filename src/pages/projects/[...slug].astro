---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Prose from '../../components/Prose.astro';
import Footer from '../../components/Footer.astro';
import { getProfile, hasOwnPage, navActions, projectImage } from '../../lib/site';

export const prerender = true;

/**
 * A page per big project that has something to say.
 *
 * Small projects never get one, and a big one without a written body doesn't
 * either — both link straight out instead. That keeps the site from filling up
 * with stubs that repeat the one-line summary and nothing else.
 */
export const getStaticPaths: GetStaticPaths = async () => {
  const projects = await getCollection('projects');
  return projects
    .filter((p) => p.data.published && hasOwnPage(p))
    .map((p) => ({ params: { slug: p.id }, props: { entry: p } }));
};

interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, period, summary, href } = entry.data;

const sourceLabel: string | null = href ? new URL(href).hostname.replace(/^www\./, '') : null;

const profile = await getProfile();
const cover: string = projectImage(entry);
---

<Base title={`${title} — Adarsh Ambati`} description={summary} navActions={navActions(profile)}>
  <article>
    <header class="head">
      <p class="head__back"><a href="/projects">&larr; All projects</a></p>
      <h1>{title}</h1>
      <p class="head__period u-subtle u-mono-nums">{period}</p>
      <p class="head__summary">{summary}</p>
    </header>

    <img class="cover" src={cover} alt="" width="1200" height="750" />

    <Prose><Content /></Prose>

    {
      href && sourceLabel && (
        <p class="source">
          <a href={href} rel="noopener">
            {sourceLabel} &rarr;
          </a>
        </p>
      )
    }
  </article>

  <Footer name="Adarsh Ambati" />
</Base>

<style>
  .head {
    margin-bottom: var(--space-6);
  }

  .head__back {
    padding-top: var(--space-6);
    margin-bottom: var(--space-6);
    font-size: var(--text-sm);
  }

  .cover {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-7);
  }

  .head__period {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
  }

  .head__summary {
    max-width: var(--width-prose);
    margin-top: var(--space-4);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--color-text-muted);
  }

  .source {
    margin-top: var(--space-6);
    font-size: var(--text-sm);
  }
</style>
