---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Prose from '../../components/Prose.astro';
import Footer from '../../components/Footer.astro';
import { formatDate, getProfile, navActions, type Note } from '../../lib/site';

export const prerender = true;

export const getStaticPaths: GetStaticPaths = async () => {
  const notes = await getCollection('notes');
  return notes
    .filter((n) => n.data.published)
    .map((n) => ({ params: { slug: n.id }, props: { entry: n } }));
};

interface Props {
  entry: Note;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, date, summary, papers, tags } = entry.data;

const profile = await getProfile();
---

<Base title={`${title} — Research notes`} description={summary} navActions={navActions(profile)}>
  <article>
    <p class="back"><a href="/notes">&larr; All notes</a></p>

    <header class="head">
      <time class="head__date u-mono-nums" datetime={date.toISOString()}>{formatDate(date)}</time>
      <h1>{title}</h1>
      {summary && <p class="head__summary">{summary}</p>}
    </header>

    {
      papers.length > 0 && (
        <section class="papers">
          <h2 class="papers__label">Papers</h2>
          <ul class="papers__list">
            {papers.map((p) => (
              <li>
                {p.href ? (
                  <a href={p.href} rel="noopener">
                    {p.title}
                  </a>
                ) : (
                  <span>{p.title}</span>
                )}
                {p.authors && <span class="papers__authors"> — {p.authors}</span>}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <Prose><Content /></Prose>

    {
      tags.length > 0 && (
        <ul class="tags">
          {tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )
    }
  </article>

  <Footer name={profile.data.name} />
</Base>

<style>
  .back {
    padding-top: var(--space-6);
    font-size: var(--text-sm);
  }

  .head {
    margin: var(--space-6) 0;
  }

  .head__date {
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
  }

  h1 {
    margin-top: var(--space-2);
    font-size: var(--text-3xl);
  }

  .head__summary {
    max-width: var(--width-prose);
    margin-top: var(--space-3);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--color-text-muted);
  }

  .papers {
    max-width: var(--width-prose);
    margin-bottom: var(--space-6);
    padding: var(--space-4);
    background: var(--color-surface);
    border-radius: var(--radius-md);
  }

  .papers__label {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .papers__list {
    margin-top: var(--space-2);
    padding-left: var(--space-4);
    font-size: var(--text-sm);
  }

  .papers__list li + li {
    margin-top: var(--space-1);
  }

  .papers__authors {
    color: var(--color-text-subtle);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-7);
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: 0.15rem 0.5rem;
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    background: var(--color-surface);
    border-radius: var(--radius-sm);
  }
</style>
