---
import Base from '../../layouts/Base.astro';
import NoteRow from '../../components/NoteRow.astro';
import Footer from '../../components/Footer.astro';
import { getNotes, getProfile, groupNotesByTopic, navActions } from '../../lib/site';

export const prerender = true;

const profile = await getProfile();
const topics = groupNotesByTopic(await getNotes());
const { name } = profile.data;
---

<Base
  title={`Notes on interests — ${name}`}
  description="Notes on papers, grouped by topic, written up as I read them."
  navActions={navActions(profile)}
>
  <header class="head">
    <h1>Notes on interests</h1>
    <p class="head__note">Grouped by topic. Notes on papers, written up as I read them.</p>
  </header>

  {
    topics.length > 0 ? (
      <div class="topics">
        {topics.map((topic) => (
          <section class="topic">
            <h2 class="topic__label">{topic.label}</h2>
            <div class="list">
              {topic.notes.map((n) => (
                <NoteRow entry={n} />
              ))}
            </div>
          </section>
        ))}
      </div>
    ) : (
      <p class="empty">
        Nothing published yet. Copy{' '}
        <code>src/content/notes/example-topic/2026-08-15-template.md</code>{' '}
        into a new or existing topic folder, rename it to today's date, set{' '}
        <code>published: true</code>, and write.
      </p>
    )
  }

  <Footer name={name} />
</Base>

<style>
  .head {
    padding: var(--space-7) 0 0;
  }

  .head__note {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
  }

  .topics {
    margin-top: var(--space-7);
  }

  .topic + .topic {
    margin-top: var(--space-8);
  }

  .topic__label {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .list {
    margin-top: var(--space-3);
  }

  .empty {
    max-width: var(--width-prose);
    margin-top: var(--space-6);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
</style>
