---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import HeroFull from '../components/HeroFull.astro';
import Affiliations from '../components/Affiliations.astro';
import Section from '../components/Section.astro';
import ProjectFeature from '../components/ProjectFeature.astro';
import NoteRow from '../components/NoteRow.astro';
import ThoughtRow from '../components/ThoughtRow.astro';
import LinkList from '../components/LinkList.astro';
import Prose from '../components/Prose.astro';
import Footer from '../components/Footer.astro';
import {
  KIND_LABEL,
  getProfile,
  getFeatured,
  getNotes,
  getThoughts,
  heroLinks,
  navActions,
  projectImage,
  projectTarget,
} from '../lib/site';

export const prerender = true;

const profile = await getProfile();
const { Content } = await render(profile);
const { name, eyebrow, tagline, location, description, credentials, affiliations, emails, links } =
  profile.data;

/* The homepage is a landing page, not an archive — a handful of each, with the
   full lists a click away. */
const featured = await getFeatured(3);
const recentNotes = (await getNotes()).slice(0, 3);
const recentThoughts = (await getThoughts()).slice(0, 3);
---

<Base title={`${name} — ${tagline}`} description={description} navActions={navActions(profile)}>
  <HeroFull
    slot="bleed"
    name={name}
    eyebrow={eyebrow}
    tagline={tagline}
    location={location}
    credentials={credentials}
    links={heroLinks(profile)}
  />

  <Affiliations items={affiliations} />

  <Section id="about" title="About">
    <Prose><Content /></Prose>
  </Section>

  {
    featured.length > 0 && (
      <Section id="projects" title="Projects" note="A few things I've built.">
        {featured.map((p, i) => {
          const { href, internal } = projectTarget(p);
          return (
            <ProjectFeature
              title={p.data.title}
              period={p.data.period}
              summary={p.data.summary}
              image={projectImage(p)}
              kind={KIND_LABEL[p.data.kind]}
              href={href}
              internal={internal}
              flip={i % 2 === 1}
            />
          );
        })}
        <p class="more">
          <a href="/projects">View all projects &rarr;</a>
        </p>
      </Section>
    )
  }

  {
    recentNotes.length > 0 && (
      <Section id="notes" title="Notes on interests" note="Notes on papers, grouped by topic.">
        {recentNotes.map((n) => (
          <NoteRow entry={n} />
        ))}
        <p class="more">
          <a href="/notes">View all notes &rarr;</a>
        </p>
      </Section>
    )
  }

  {
    recentThoughts.length > 0 && (
      <Section id="thoughts" title="Thoughts" note="The latest essays.">
        {recentThoughts.map((t) => (
          <ThoughtRow entry={t} />
        ))}
        <p class="more">
          <a href="/thoughts">View all thoughts &rarr;</a>
        </p>
      </Section>
    )
  }

  <Section id="contact" title="Contact">
    <LinkList emails={emails} links={links} />
  </Section>

  <Footer name={name} />
</Base>

<style>
  .more {
    margin-top: var(--space-5);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  .more a {
    text-decoration: none;
    color: var(--color-accent);
  }

  .more a:hover {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
</style>
