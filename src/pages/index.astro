---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Affiliations from '../components/Affiliations.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import NoteRow from '../components/NoteRow.astro';
import LinkList from '../components/LinkList.astro';
import Prose from '../components/Prose.astro';
import Footer from '../components/Footer.astro';
import {
  getProfile,
  getProjects,
  getNotes,
  navActions,
  projectImage,
  projectTarget,
} from '../lib/site';

export const prerender = true;

const profile = await getProfile();
const { Content } = await render(profile);
const { name, eyebrow, tagline, description, credentials, affiliations, portrait, emails, links } =
  profile.data;

const projects = await getProjects();
const notes = await getNotes();

/* The homepage is a landing page, not an archive — a handful of each, with the
   full lists a click away. */
const featured = projects.filter((p) => p.data.featured).slice(0, 3);
const recentNotes = notes.slice(0, 3);
---

<Base title={`${name} — ${tagline}`} description={description} navActions={navActions(profile)}>
  <Hero
    name={name}
    eyebrow={eyebrow}
    tagline={tagline}
    portrait={portrait}
    credentials={credentials}
  />

  <Affiliations items={affiliations} />

  <Section id="about" title="About">
    <Prose><Content /></Prose>
  </Section>

  {
    featured.length > 0 && (
      <Section id="projects" title="Projects" note="A few things I've built.">
        {featured.map((p) => {
          const { href, internal } = projectTarget(p);
          return (
            <Card
              title={p.data.title}
              period={p.data.period}
              summary={p.data.summary}
              href={href}
              internal={internal}
              image={projectImage(p)}
            />
          );
        })}
        <p class="more">
          <a href="/projects">View all projects &rarr;</a>
        </p>
      </Section>
    )
  }

  {
    recentNotes.length > 0 && (
      <Section id="notes" title="Research notes" note="Notes from what I read.">
        {recentNotes.map((n) => (
          <NoteRow entry={n} />
        ))}
        <p class="more">
          <a href="/notes">View all notes &rarr;</a>
        </p>
      </Section>
    )
  }

  <Section id="contact" title="Contact">
    <LinkList emails={emails} links={links} />
  </Section>

  <Footer name={name} />
</Base>

<style>
  .more {
    margin-top: var(--space-5);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  .more a {
    text-decoration: none;
    color: var(--color-accent);
  }

  .more a:hover {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
</style>
