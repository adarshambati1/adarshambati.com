---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import LinkList from '../components/LinkList.astro';
import Footer from '../components/Footer.astro';

export const prerender = true;

type Project = CollectionEntry<'projects'>;
type SectionKey = Project['data']['section'];

const [profile] = await getCollection('profile');
if (!profile) throw new Error('Missing src/content/site/profile.md');

const { Content } = await render(profile);
const { name, tagline, description, current, portrait, emails, links } = profile.data;

const projects: Project[] = (await getCollection('projects'))
  .filter((p) => p.data.published)
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));

const SECTIONS: readonly { key: SectionKey; id: string; title: string; note?: string }[] = [
  { key: 'research', id: 'research', title: 'Research' },
  { key: 'ventures', id: 'companies', title: 'Companies' },
  { key: 'earlier', id: 'earlier', title: 'Earlier', note: 'Work from before the robotics turn.' },
];

/** A project links to its own page when it has a write-up, otherwise outward. */
function target(p: Project): { href: string | undefined; internal: boolean } {
  if (p.body?.trim()) return { href: `/projects/${p.id}`, internal: true };
  return { href: p.data.href, internal: false };
}
---

<Base title={`${name} — ${tagline}`} description={description}>
  <Hero
    name={name}
    tagline={tagline}
    {...(portrait ? { portrait } : {})}
    {...(current ? { current } : {})}
  >
    <Content />
  </Hero>

  {
    SECTIONS.map(({ key, id, title, note }) => {
      const items = projects.filter((p) => p.data.section === key);
      if (items.length === 0) return null;
      const compact = key === 'earlier';
      return (
        <Section id={id} title={title} note={note} quiet={compact}>
          {items.map((p) => {
            const { href, internal } = target(p);
            return (
              <Card
                title={p.data.title}
                period={p.data.period}
                summary={p.data.summary}
                href={href}
                internal={internal}
                compact={compact}
              />
            );
          })}
        </Section>
      );
    })
  }

  <Section id="contact" title="Contact">
    <LinkList emails={emails} links={links} />
  </Section>

  <Footer name={name} />
</Base>
