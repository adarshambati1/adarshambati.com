---
import HeroScene from '../../components/HeroScene.astro';

/**
 * Dev-only preview of both hero scenes. Not linked from anywhere, 404s in
 * production, and isn't prerendered.
 */
export const prerender = false;

if (import.meta.env.PROD) {
  return new Response(null, { status: 404 });
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Hero scenes — preview</title>
    <meta name="robots" content="noindex, nofollow" />
    <style is:global>
      :root {
        --header-height: 0px;
        --space-1: 0.25rem;
        --space-3: 0.75rem;
      }
      body {
        margin: 0;
        background: #080a10;
        color: #9aa7c4;
        font: 13px system-ui, sans-serif;
      }
      .stack > section {
        position: relative;
        height: 70vh;
        border-bottom: 1px solid rgba(160, 180, 225, 0.15);
      }
      .stack h2 {
        position: absolute;
        z-index: 3;
        left: 24px;
        top: 20px;
        margin: 0;
        font-size: 0.75rem;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        color: #8ea0c8;
      }
    </style>
  </head>
  <body>
    <div class="stack">
      <section>
        <h2>scan — real PandaSet frame</h2>
        <HeroScene mode="scan" />
      </section>
      <section>
        <h2>arm — Flexiv Rizon 4s, CCD IK</h2>
        <HeroScene mode="arm" />
      </section>
    </div>
  </body>
</html>
