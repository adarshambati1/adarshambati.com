---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Prose from '../../components/Prose.astro';
import Footer from '../../components/Footer.astro';
import { formatDate, getProfile, navActions, type Thought } from '../../lib/site';

export const prerender = true;

export const getStaticPaths: GetStaticPaths = async () => {
  const thoughts = await getCollection('thoughts');
  return thoughts
    .filter((t) => t.data.published)
    .map((t) => ({ params: { slug: t.id }, props: { entry: t } }));
};

interface Props {
  entry: Thought;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, date, summary, tags } = entry.data;

const profile = await getProfile();
---

<Base title={`${title} — Thoughts`} description={summary} navActions={navActions(profile)}>
  <article>
    <p class="back"><a href="/thoughts">&larr; All thoughts</a></p>

    <header class="head">
      <time class="head__date u-mono-nums" datetime={date.toISOString()}>{formatDate(date)}</time>
      <h1>{title}</h1>
      {summary && <p class="head__summary">{summary}</p>}
    </header>

    <Prose><Content /></Prose>

    {
      tags.length > 0 && (
        <ul class="tags">
          {tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )
    }
  </article>

  <Footer name={profile.data.name} />
</Base>

<style>
  .back {
    padding-top: var(--space-6);
    font-size: var(--text-sm);
  }

  .head {
    margin: var(--space-6) 0;
  }

  .head__date {
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
  }

  h1 {
    margin-top: var(--space-2);
    font-size: var(--text-3xl);
  }

  .head__summary {
    max-width: var(--width-prose);
    margin-top: var(--space-3);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--color-text-muted);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-7);
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: 0.15rem 0.5rem;
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    background: var(--color-surface);
    border-radius: var(--radius-sm);
  }
</style>
