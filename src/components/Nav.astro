---
/** Sticky site header: section links left of centre, contact actions right. */
export interface NavLink {
  readonly label: string;
  readonly href: string;
}

export interface NavAction {
  readonly label: string;
  readonly href: string;
  /** Filled rather than outlined. Use for the single primary action. */
  readonly primary?: boolean;
}

interface Props {
  name: string;
  links?: readonly NavLink[];
  actions?: readonly NavAction[];
}

const DEFAULT_LINKS: readonly NavLink[] = [
  { label: 'Projects', href: '/projects' },
  { label: 'Notes', href: '/notes' },
];

const { name, links = DEFAULT_LINKS, actions = [] } = Astro.props;
const path = Astro.url.pathname;

/** Marks the section you're in, including its child pages. */
const isCurrent = (href: string): boolean => href !== '/' && path.startsWith(href);
---

<header class="nav">
  <div class="nav__inner">
    <a class="nav__brand" href="/">{name}</a>

    <nav class="nav__sections" aria-label="Primary">
      <ul class="nav__list">
        {
          links.map((link) => (
            <li>
              <a
                class:list={['nav__link', { 'nav__link--current': isCurrent(link.href) }]}
                href={link.href}
                aria-current={isCurrent(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      actions.length > 0 && (
        <ul class="nav__actions">
          {actions.map((action) => (
            <li>
              <a
                class:list={['pill', { 'pill--primary': action.primary }]}
                href={action.href}
                rel="me noopener"
              >
                {action.label}
                {action.primary && <span aria-hidden="true"> &rarr;</span>}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--color-border);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    max-width: var(--width-content);
    height: var(--header-height);
    margin: 0 auto;
    padding: 0 var(--space-5);
  }

  .nav__brand {
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
    text-decoration: none;
    white-space: nowrap;
  }

  .nav__sections {
    flex: 1;
  }

  .nav__list,
  .nav__actions {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    list-style: none;
    padding: 0;
  }

  .nav__actions {
    gap: var(--space-2);
  }

  .nav__link {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .nav__link:hover,
  .nav__link--current {
    color: var(--color-text);
  }

  .pill {
    display: inline-block;
    padding: 0.4rem 0.85rem;
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--color-accent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 35%, transparent);
    border-radius: 999px;
    text-decoration: none;
    white-space: nowrap;
    transition: background var(--transition), border-color var(--transition);
  }

  .pill:hover {
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 7%, transparent);
    border-color: var(--color-accent);
  }

  .pill--primary {
    color: #fff;
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .pill--primary:hover {
    color: #fff;
    background: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
  }

  /* Below this the brand plus two pills fills the bar; the section links are a
     scroll away on a page people scroll anyway. */
  @media (max-width: 40rem) {
    .nav__inner {
      gap: var(--space-4);
    }
    .nav__sections {
      display: none;
    }
    .nav__actions {
      margin-left: auto;
    }
  }

  @media (max-width: 24rem) {
    .nav__actions li:first-child {
      display: none;
    }
  }
</style>
