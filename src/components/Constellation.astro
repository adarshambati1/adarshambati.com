---
/**
 * Drifting point network for the hero background.
 *
 * Points wander slowly and draw a line to any neighbour within a threshold,
 * fading with distance — so the mesh forms and dissolves as they pass. Density
 * scales with viewport area so a large screen doesn't end up sparse and a phone
 * doesn't end up soup.
 *
 * Purely decorative: aria-hidden, and frozen under prefers-reduced-motion.
 */
---

<canvas class="constellation" data-constellation aria-hidden="true"></canvas>

<style>
  .constellation {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
</style>

<script>
  interface Point {
    x: number;
    y: number;
    vx: number;
    vy: number;
    r: number;
  }

  const LINK_DISTANCE = 148;
  /** One point per this many square pixels of viewport. */
  const AREA_PER_POINT = 13_000;
  const MAX_POINTS = 130;

  function start(canvas: HTMLCanvasElement): void {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let points: Point[] = [];
    let raf = 0;
    let w = 0;
    let h = 0;

    function seed(): void {
      const count = Math.min(MAX_POINTS, Math.round((w * h) / AREA_PER_POINT));
      points = Array.from({ length: count }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        // Slow enough that the mesh reads as drifting, not swarming.
        vx: (Math.random() - 0.5) * 0.16,
        vy: (Math.random() - 0.5) * 0.16,
        r: 0.9 + Math.random() * 1.5,
      }));
    }

    function resize(): void {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      const rect = canvas.getBoundingClientRect();
      w = rect.width;
      h = rect.height;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      seed();
    }

    function draw(): void {
      if (!ctx) return;
      ctx.clearRect(0, 0, w, h);

      // Links first, so the nodes sit on top of them.
      for (let i = 0; i < points.length; i++) {
        const a = points[i];
        if (!a) continue;
        for (let j = i + 1; j < points.length; j++) {
          const b = points[j];
          if (!b) continue;
          const dx = a.x - b.x;
          const dy = a.y - b.y;
          const d = Math.hypot(dx, dy);
          if (d > LINK_DISTANCE) continue;
          const alpha = (1 - d / LINK_DISTANCE) * 0.33;
          ctx.strokeStyle = `rgba(168,186,232,${alpha.toFixed(3)})`;
          ctx.lineWidth = 0.7;
          ctx.beginPath();
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(b.x, b.y);
          ctx.stroke();
        }
      }

      for (const p of points) {
        ctx.fillStyle = 'rgba(214,226,255,0.72)';
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    function step(): void {
      for (const p of points) {
        p.x += p.vx;
        p.y += p.vy;
        // Wrap rather than bounce — bouncing makes the edges visibly busier
        // than the middle.
        if (p.x < -10) p.x = w + 10;
        if (p.x > w + 10) p.x = -10;
        if (p.y < -10) p.y = h + 10;
        if (p.y > h + 10) p.y = -10;
      }
      draw();
      raf = requestAnimationFrame(step);
    }

    resize();
    addEventListener('resize', () => {
      resize();
      draw();
    }, { passive: true });

    if (reduced) {
      draw();
      return;
    }
    raf = requestAnimationFrame(step);

    // Don't animate a hero that's scrolled past.
    new IntersectionObserver((entries) => {
      const visible = entries[0]?.isIntersecting ?? false;
      if (visible && !raf) raf = requestAnimationFrame(step);
      else if (!visible && raf) {
        cancelAnimationFrame(raf);
        raf = 0;
      }
    }).observe(canvas);
  }

  document
    .querySelectorAll<HTMLCanvasElement>('canvas[data-constellation]')
    .forEach(start);
</script>
