---
/** Top of the homepage: who you are, where you work, and the intro prose. */
interface Props {
  name: string;
  tagline: string;
  portrait?: string;
  current?: {
    role: string;
    org: string;
    href?: string | undefined;
  };
}

const { name, tagline, portrait, current } = Astro.props;
---

<section class="hero">
  {
    portrait && (
      <img class="hero__portrait" src={`/${portrait}`} alt="" width="88" height="88" loading="eager" />
    )
  }

  <div class="hero__body">
    <h1 class="hero__name">{name}</h1>

    {
      /* Directly under the name, at full text colour. This is the credibility
         line — as muted metadata below the tagline it read as an afterthought. */
      current && (
        <p class="hero__current">
          {current.role} at{' '}
          {current.href ? (
            <a class="hero__org" href={current.href}>
              {current.org}
            </a>
          ) : (
            <span>{current.org}</span>
          )}
        </p>
      )
    }

    <p class="hero__tagline">{tagline}</p>
  </div>
</section>

<div class="hero__prose">
  <slot />
</div>

<style>
  .hero {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .hero__portrait {
    flex: none;
    width: 88px;
    height: 88px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--color-surface);
  }

  .hero__name {
    font-size: var(--text-3xl);
  }

  .hero__current {
    margin-top: var(--space-2);
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    color: var(--color-text);
  }

  .hero__org {
    color: var(--color-accent);
    text-decoration-color: color-mix(in srgb, var(--color-accent) 35%, transparent);
  }

  .hero__tagline {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .hero__prose {
    max-width: var(--width-prose);
    margin-top: var(--space-6);
    color: var(--color-text-muted);
  }

  .hero__prose :global(p + p) {
    margin-top: var(--space-4);
  }

  @media (max-width: 30rem) {
    .hero {
      align-items: flex-start;
      gap: var(--space-4);
    }
    .hero__portrait {
      width: 64px;
      height: 64px;
    }
  }
</style>
