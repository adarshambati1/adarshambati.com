---
/** A titled block. `id` doubles as the nav anchor target. */
interface Props {
  id: string;
  title: string;
  /** Optional line under the heading. */
  note?: string | undefined;
  /** Quieter entrance for de-emphasised sections, so "Earlier" doesn't arrive
   *  with the same weight as current work. */
  quiet?: boolean;
}

const { id, title, note, quiet = false } = Astro.props;
---

<section class:list={['section', { 'section--quiet': quiet }]} id={id}>
  <div class="section__head">
    <h2 class="section__title">{title}</h2>
    {note && <p class="section__note">{note}</p>}
  </div>
  <slot />
</section>

<style>
  .section {
    margin-top: var(--space-9);
  }

  .section--quiet {
    margin-top: var(--space-8);
  }

  .section__head {
    margin-bottom: var(--space-4);
  }

  /* Full h2 size. At --text-xl it sat only 3px above card titles, which left
     section headers and entry titles reading as the same level. */
  .section__title {
    font-size: var(--text-2xl);
  }

  .section--quiet .section__title {
    font-size: var(--text-xl);
    color: var(--color-text-muted);
  }

  .section__note {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
  }
</style>
