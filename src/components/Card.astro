---
/**
 * One entry in a listing — a project, a company, an older piece of work.
 *
 * Thumbnail left, content right. Borderless: dividers and spacing carry the
 * structure, so the page doesn't turn into a grid of boxes on an already-white
 * background. `href` stretches over the row via a pseudo-element on the title
 * link, keeping one link in the accessibility tree rather than wrapping
 * everything in an anchor.
 */
interface Props {
  title: string;
  period: string;
  summary: string;
  href?: string | undefined;
  image?: string | undefined;
  /** true when href points at a page on this site rather than off it. */
  internal?: boolean;
  /** Tighter treatment for de-emphasised entries; also hides the thumbnail. */
  compact?: boolean;
}

const {
  title,
  period,
  summary,
  href,
  image,
  internal = false,
  compact = false,
} = Astro.props;

const cue: string | null = href ? (internal ? 'Learn more' : 'Visit') : null;
const showImage: boolean = Boolean(image) && !compact;
---

<article class:list={['row', { 'row--compact': compact, 'row--linked': Boolean(href) }]}>
  {
    showImage && (
      <div class="row__media">
        <img src={image} alt="" width="200" height="125" loading="lazy" decoding="async" />
      </div>
    )
  }

  <div class="row__body">
    <div class="row__head">
      <h3 class="row__title">
        {
          href ? (
            <a class="row__link" href={href} {...(internal ? {} : { rel: 'noopener' })}>
              {title}
            </a>
          ) : (
            title
          )
        }
      </h3>
      <span class="row__period u-mono-nums">{period}</span>
    </div>

    <p class="row__summary">{summary}</p>

    {cue && !compact && <span class="row__cue">{cue} &rarr;</span>}
  </div>
</article>

<style>
  .row {
    position: relative;
    display: flex;
    gap: var(--space-5);
    padding: var(--space-5) 0;
    border-top: 1px solid var(--color-border);
  }

  .row:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  /* Bleeds the hover tint past the text column so the row reads as one target
     without needing a visible box at rest. */
  .row--linked::before {
    content: '';
    position: absolute;
    inset: 0 calc(var(--space-4) * -1);
    border-radius: var(--radius-md);
    background: transparent;
    transition: background var(--transition);
    z-index: -1;
  }

  .row--linked:hover::before {
    background: var(--color-bg-subtle);
  }

  .row__media {
    flex: none;
    width: 200px;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .row__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .row__body {
    min-width: 0;
    flex: 1;
  }

  .row__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .row__title {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-normal);
  }

  .row__link {
    text-decoration: none;
  }

  .row__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .row--linked:hover .row__title {
    color: var(--color-accent);
  }

  .row__period {
    flex: none;
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }

  .row__summary {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .row__cue {
    display: inline-block;
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--color-text-subtle);
    transition: color var(--transition);
  }

  .row--linked:hover .row__cue {
    color: var(--color-accent);
  }

  .row--compact {
    padding: var(--space-3) 0;
  }

  .row--compact .row__title {
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
  }

  .row--compact .row__summary {
    margin-top: var(--space-1);
  }

  @media (max-width: 34rem) {
    .row {
      flex-direction: column;
      gap: var(--space-3);
    }
    .row__media {
      width: 100%;
    }
  }
</style>
