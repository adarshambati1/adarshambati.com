---
/**
 * One entry in a section — a project, a company, an older piece of work.
 *
 * Deliberately borderless. Boxing every entry in a 1px rounded rectangle on an
 * already-white page adds a container that carries no information and makes the
 * page read like a component-library demo. Dividers and spacing do the same job
 * quietly, and let the content set the hierarchy.
 *
 * `href` makes the whole row clickable via a stretched pseudo-element on the
 * title link, which keeps one link in the accessibility tree rather than
 * wrapping the row in an anchor.
 */
interface Props {
  title: string;
  period: string;
  summary: string;
  href?: string | undefined;
  /** true when href points at a page on this site rather than off it. */
  internal?: boolean;
  /** Tighter treatment for de-emphasised entries. */
  compact?: boolean;
}

const { title, period, summary, href, internal = false, compact = false } = Astro.props;
---

<article class:list={['row', { 'row--compact': compact, 'row--linked': Boolean(href) }]}>
  <div class="row__head">
    <h3 class="row__title">
      {
        href ? (
          <a class="row__link" href={href} {...(internal ? {} : { rel: 'noopener' })}>
            {title}
          </a>
        ) : (
          title
        )
      }
    </h3>
    <span class="row__period u-mono-nums">{period}</span>
  </div>

  <p class="row__summary">{summary}</p>
</article>

<style>
  .row {
    position: relative;
    padding: var(--space-4) 0;
    border-top: 1px solid var(--color-border);
  }

  .row:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  /* Bleeds the hover tint past the text column so the row reads as one target
     without needing a visible box at rest. */
  .row--linked::before {
    content: '';
    position: absolute;
    inset: 0 calc(var(--space-3) * -1);
    border-radius: var(--radius-md);
    background: transparent;
    transition: background var(--transition);
    z-index: -1;
  }

  .row--linked:hover::before {
    background: var(--color-bg-subtle);
  }

  .row__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .row__title {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-normal);
  }

  .row__link {
    text-decoration: none;
  }

  .row__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .row--linked:hover .row__title {
    color: var(--color-accent);
  }

  .row__period {
    flex: none;
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }

  .row__summary {
    max-width: var(--width-prose);
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .row--compact {
    padding: var(--space-3) 0;
  }

  .row--compact .row__title {
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
  }

  .row--compact .row__summary {
    margin-top: var(--space-1);
  }
</style>
