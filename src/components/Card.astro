---
/**
 * A project or role. `href` makes the whole card clickable via a stretched
 * pseudo-element on the title link, which keeps a single link in the
 * accessibility tree instead of wrapping the card in an anchor.
 */
interface Props {
  title: string;
  period: string;
  summary: string;
  href?: string | undefined;
  /** true when href points at a page on this site rather than off it. */
  internal?: boolean;
  /** Tighter padding and no hover affordance, for de-emphasised entries. */
  compact?: boolean;
}

const { title, period, summary, href, internal = false, compact = false } = Astro.props;
const cue = href ? (internal ? 'Read more' : 'Visit') : null;
---

<article class:list={['card', { 'card--compact': compact, 'card--linked': Boolean(href) }]}>
  <div class="card__head">
    <h3 class="card__title">
      {
        href ? (
          <a class="card__link" href={href} {...(internal ? {} : { rel: 'noopener' })}>
            {title}
          </a>
        ) : (
          title
        )
      }
    </h3>
    <span class="card__period u-mono-nums">{period}</span>
  </div>

  <p class="card__summary">{summary}</p>

  {cue && !compact && <span class="card__cue" aria-hidden="true">{cue} &rarr;</span>}
</article>

<style>
  .card {
    position: relative;
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg);
    transition: border-color var(--transition), background var(--transition);
  }

  .card + .card {
    margin-top: var(--space-3);
  }

  .card--linked:hover {
    border-color: var(--color-border-strong);
    background: var(--color-bg-subtle);
  }

  .card__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .card__title {
    font-size: var(--text-lg);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-normal);
  }

  .card__link {
    text-decoration: none;
  }

  /* Expands the title link to cover the card, so the whole surface is a target
     without nesting interactive elements. */
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .card__period {
    flex: none;
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }

  .card__summary {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .card__cue {
    display: inline-block;
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--color-text-subtle);
    transition: color var(--transition);
  }

  .card--linked:hover .card__cue {
    color: var(--color-accent);
  }

  .card--compact {
    padding: var(--space-4) var(--space-5);
  }

  .card--compact .card__title {
    font-size: var(--text-base);
  }
</style>
