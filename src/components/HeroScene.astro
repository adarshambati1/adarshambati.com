---
/**
 * Full-bleed 3D scene behind the hero. Text sits on top of the world rather
 * than beside it, so there's no hard divide.
 *
 * Picks one of two scenes per visit, 50/50:
 *
 *   cars — a LiDAR point cloud of a street, ray-cast from a simulated spinning
 *          multi-beam sensor against a ground plane and oriented boxes. The
 *          rings, the shadows behind vehicles and the gap under each car all
 *          fall out of the cast; none of it is drawn by hand.
 *   arm  — a 7-DOF Kinova-style manipulator picking a grape, running forward
 *          kinematics with CCD inverse kinematics onto the target.
 *
 * Both are drag-to-rotate. The scene is composed right-of-centre so it doesn't
 * sit under the headline.
 */
interface Props {
  /** Pin a scene instead of choosing at random. */
  mode?: 'auto' | 'cars' | 'arm';
}

const { mode = 'auto' } = Astro.props;
---

<div class="scene">
  <canvas class="scene__canvas" data-hero-scene data-mode={mode}></canvas>

  <span class="scene__tick scene__tick--tr" aria-hidden="true"></span>
  <span class="scene__tick scene__tick--br" aria-hidden="true"></span>

  <dl class="scene__readout" aria-hidden="true">
    <div><dt data-label="a">Source</dt><dd data-stat="a">—</dd></div>
    <div><dt data-label="b">Points</dt><dd data-stat="b">—</dd></div>
    <div><dt data-label="c">Range</dt><dd data-stat="c">—</dd></div>
  </dl>

  <p class="scene__hint" aria-hidden="true">drag to rotate</p>
</div>

<style>
  .scene {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .scene__canvas {
    display: block;
    width: 100%;
    height: 100%;
    cursor: grab;
    touch-action: none;
  }

  .scene__canvas:active {
    cursor: grabbing;
  }

  .scene__tick {
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: rgba(160, 180, 225, 0.4);
    border-style: solid;
    pointer-events: none;
  }

  .scene__tick--tr {
    top: calc(var(--header-height) + 20px);
    right: 24px;
    border-width: 1px 1px 0 0;
  }

  .scene__tick--br {
    right: 24px;
    bottom: 24px;
    border-width: 0 1px 1px 0;
  }

  .scene__readout {
    position: absolute;
    right: 24px;
    top: calc(var(--header-height) + 44px);
    display: grid;
    gap: 0.3rem;
    margin: 0;
    padding: 0.7rem 0.85rem;
    font-size: 0.6875rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: rgba(190, 205, 235, 0.75);
    background: rgba(8, 10, 16, 0.5);
    border: 1px solid rgba(160, 180, 225, 0.16);
    border-radius: 6px;
    backdrop-filter: blur(4px);
    pointer-events: none;
  }

  .scene__readout div {
    display: flex;
    justify-content: space-between;
    gap: 1.75rem;
  }

  .scene__readout dt {
    color: rgba(150, 168, 205, 0.7);
  }

  .scene__readout dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
    color: rgba(215, 228, 255, 0.95);
  }

  .scene__hint {
    position: absolute;
    right: 24px;
    bottom: 48px;
    margin: 0;
    font-size: 0.6875rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: rgba(160, 180, 225, 0.45);
    pointer-events: none;
  }

  @media (max-width: 52rem) {
    .scene__readout,
    .scene__hint,
    .scene__tick {
      display: none;
    }
  }
</style>

<script>
  import { forward as armFK, solveIK as armIK, MESHES, TRIANGLES, MODEL_NAME } from '../lib/rizon';

  type Vec3 = [number, number, number];

  /* ---------------------------------------------------------------- math -- */

  // Matrix and kinematics helpers live in src/lib/rizon.ts alongside the model.
  const clamp = (v: number, lo: number, hi: number): number => Math.max(lo, Math.min(hi, v));
  const lerp = (a: number, b: number, t: number): number => a + (b - a) * t;
  /** Smoothstep, so approaches ease in and out. */
  const ease = (t: number): number => t * t * (3 - 2 * t);

  /* ------------------------------------------------------------- camera -- */

  interface Cam {
    az: number;
    el: number;
    zoom: number;
    cx: number;
    cy: number;
    /** Perspective falloff per unit depth. */
    persp: number;
  }

  interface Screen {
    x: number;
    y: number;
    depth: number;
    k: number;
  }

  function project(p: Vec3, cam: Cam): Screen {
    const ca = Math.cos(cam.az);
    const sa = Math.sin(cam.az);
    const x1 = p[0] * ca - p[1] * sa;
    const y1 = p[0] * sa + p[1] * ca;
    const ce = Math.cos(cam.el);
    const se = Math.sin(cam.el);
    const height = p[2] * ce - y1 * se;
    const depth = y1 * ce + p[2] * se;
    const k = 1 / (1 + depth * cam.persp);
    return { x: cam.cx + x1 * cam.zoom * k, y: cam.cy - height * cam.zoom * k, depth, k };
  }

  /* ----------------------------------------------------------- car scene -- */

  interface Box {
    cx: number;
    cy: number;
    z0: number;
    z1: number;
    hx: number;
    hy: number;
    yaw: number;
  }

  /** A car as two stacked boxes: body, then a shorter inset cabin. */
  function car(cx: number, cy: number, yaw: number, scale = 1): Box[] {
    const l = 4.5 * scale;
    const w = 1.85 * scale;
    return [
      { cx, cy, z0: 0.28, z1: 0.95, hx: l / 2, hy: w / 2, yaw },
      { cx, cy, z0: 0.95, z1: 1.5, hx: l * 0.27, hy: w * 0.44, yaw },
    ];
  }

  const BOXES: Box[] = [
    ...car(6.2, 2.9, 0.02),
    ...car(13.5, 3.1, -0.03),
    ...car(20.5, 2.9, 0.015),
    ...car(8.5, -3.0, Math.PI),
    ...car(16.5, -3.2, Math.PI + 0.04),
    ...car(-6.5, -2.9, Math.PI),
    ...car(-12, 3.0, 0.02),
    ...car(3.4, 6.4, 0.44, 1.22),
  ];

  const SENSOR_H = 1.9;
  const BEAMS = 26;
  const AZIMUTH_STEPS = 680;
  const MAX_RANGE = 27;

  function hitBox(o: Vec3, d: Vec3, b: Box): number {
    const c = Math.cos(-b.yaw);
    const s = Math.sin(-b.yaw);
    const ox = (o[0] - b.cx) * c - (o[1] - b.cy) * s;
    const oy = (o[0] - b.cx) * s + (o[1] - b.cy) * c;
    const dx = d[0] * c - d[1] * s;
    const dy = d[0] * s + d[1] * c;

    let tmin = 0;
    let tmax = MAX_RANGE;
    const slab = (start: number, dir: number, lo: number, hi: number): boolean => {
      if (Math.abs(dir) < 1e-9) return start >= lo && start <= hi;
      let t0 = (lo - start) / dir;
      let t1 = (hi - start) / dir;
      if (t0 > t1) [t0, t1] = [t1, t0];
      tmin = Math.max(tmin, t0);
      tmax = Math.min(tmax, t1);
      return tmax >= tmin;
    };

    if (!slab(ox, dx, -b.hx, b.hx)) return Infinity;
    if (!slab(oy, dy, -b.hy, b.hy)) return Infinity;
    if (!slab(o[2], d[2], b.z0, b.z1)) return Infinity;
    return tmin > 0.05 ? tmin : Infinity;
  }

  interface Cloud {
    xyz: Float32Array;
    rgb: Uint8Array;
    /** 1 = vehicle. Vehicles draw larger and brighter than road. */
    kind: Uint8Array;
    count: number;
  }

  function ramp(t: number): [number, number, number] {
    const u = clamp(t, 0, 1);
    const stops: [number, [number, number, number]][] = [
      [0, [40, 82, 200]],
      [0.35, [38, 168, 224]],
      [0.62, [66, 212, 162]],
      [0.85, [224, 202, 92]],
      [1, [246, 148, 88]],
    ];
    for (let i = 0; i < stops.length - 1; i++) {
      const [p0, c0] = stops[i]!;
      const [p1, c1] = stops[i + 1]!;
      if (u <= p1) {
        const k = (u - p0) / (p1 - p0 || 1);
        return [
          Math.round(c0[0] + (c1[0] - c0[0]) * k),
          Math.round(c0[1] + (c1[1] - c0[1]) * k),
          Math.round(c0[2] + (c1[2] - c0[2]) * k),
        ];
      }
    }
    return stops[stops.length - 1]![1];
  }

  /** One revolution of the sensor, cast against the scene. Runs once. */
  function scanStreet(): Cloud {
    const cap = BEAMS * AZIMUTH_STEPS;
    const xyz = new Float32Array(cap * 3);
    const rgb = new Uint8Array(cap * 3);
    const kind = new Uint8Array(cap);
    const origin: Vec3 = [0, 0, SENSOR_H];
    const elMin = (-23 * Math.PI) / 180;
    const elMax = (2.5 * Math.PI) / 180;
    let n = 0;

    for (let b = 0; b < BEAMS; b++) {
      const el = elMin + ((elMax - elMin) * b) / (BEAMS - 1);
      const ce = Math.cos(el);
      const se = Math.sin(el);

      for (let a = 0; a < AZIMUTH_STEPS; a++) {
        const az = (a / AZIMUTH_STEPS) * Math.PI * 2;
        const dir: Vec3 = [Math.cos(az) * ce, Math.sin(az) * ce, se];

        let best = dir[2] < -1e-6 ? -origin[2] / dir[2] : Infinity;
        let vehicle = false;
        for (const box of BOXES) {
          const t = hitBox(origin, dir, box);
          if (t < best) {
            best = t;
            vehicle = true;
          }
        }
        if (!Number.isFinite(best) || best > MAX_RANGE) continue;

        const px = origin[0] + dir[0] * best;
        const py = origin[1] + dir[1] * best;
        const pz = origin[2] + dir[2] * best;
        xyz[n * 3] = px;
        xyz[n * 3 + 1] = py;
        xyz[n * 3 + 2] = pz;

        const [r, g, bb] = ramp(pz / 2.0);
        // Vehicles read hotter than road so the shapes separate.
        kind[n] = vehicle ? 1 : 0;
        const lift = vehicle ? 1.25 : 0.82;
        rgb[n * 3] = Math.min(255, Math.round(r * lift));
        rgb[n * 3 + 1] = Math.min(255, Math.round(g * lift));
        rgb[n * 3 + 2] = Math.min(255, Math.round(bb * lift));
        n++;
      }
    }
    return { xyz, rgb, kind, count: n };
  }

  let CLOUD: Cloud | null = null;

  function drawCars(ctx: CanvasRenderingContext2D, w: number, h: number, cam: Cam): void {
    const cloud = CLOUD!;

    // Ground grid under the points, for scale.
    ctx.strokeStyle = 'rgba(120,150,215,0.075)';
    ctx.lineWidth = 1;
    const span = 30;
    for (let g = -span; g <= span; g += 6) {
      for (const [a, b] of [
        [
          [g, -span, 0],
          [g, span, 0],
        ],
        [
          [-span, g, 0],
          [span, g, 0],
        ],
      ] as [Vec3, Vec3][]) {
        const p1 = project(a, cam);
        const p2 = project(b, cam);
        ctx.beginPath();
        ctx.moveTo(p1.x, p1.y);
        ctx.lineTo(p2.x, p2.y);
        ctx.stroke();
      }
    }

    for (let i = 0; i < cloud.count; i++) {
      const p = project(
        [cloud.xyz[i * 3]!, cloud.xyz[i * 3 + 1]!, cloud.xyz[i * 3 + 2]!],
        cam,
      );
      if (p.k <= 0 || p.x < -4 || p.x > w + 4 || p.y < -4 || p.y > h + 4) continue;
      const isVehicle = cloud.kind[i] === 1;
      const size = isVehicle ? (p.k > 0.7 ? 2.6 : 2) : p.k > 0.8 ? 1.6 : 1.2;
      const alpha = isVehicle ? 0.62 + p.k * 0.38 : 0.22 + p.k * 0.34;
      ctx.fillStyle = `rgba(${cloud.rgb[i * 3]},${cloud.rgb[i * 3 + 1]},${cloud.rgb[i * 3 + 2]},${alpha.toFixed(2)})`;
      ctx.fillRect(p.x, p.y, size, size);
    }

    const origin = project([0, 0, SENSOR_H], cam);
    ctx.fillStyle = 'rgba(235,244,255,0.95)';
    ctx.beginPath();
    ctx.arc(origin.x, origin.y, 2.6, 0, Math.PI * 2);
    ctx.fill();
  }

  /* ----------------------------------------------------------- arm scene -- */

  /**
   * Real Flexiv Rizon 4s: decimated visual meshes and the kinematic chain from
   * flexiv_description (Apache-2.0), via src/lib/rizon.ts.
   */
  const REST: readonly number[] = [0, 0.5, 0, 1.2, 0, 0.9, 0];
  const GRAPE_R = 0.028;
  /** Reachable points for a ~0.82 m arm, on the bench in front of the base. */
  const SPOTS: readonly Vec3[] = [
    [0.5, 0.16, GRAPE_R],
    [0.42, -0.26, GRAPE_R],
    [0.3, 0.34, GRAPE_R],
    [0.54, -0.05, GRAPE_R],
  ];
  const CYCLE = 7.6;

  interface ArmState {
    target: Vec3;
    grape: Vec3;
    grip: number;
    holding: boolean;
  }

  function armScene(t: number): ArmState {
    const cycle = Math.floor(t / CYCLE);
    const u = (t % CYCLE) / CYCLE;
    const spot = SPOTS[cycle % SPOTS.length] ?? SPOTS[0]!;
    const drop: Vec3 = [0.16, -0.46, GRAPE_R];
    const home: Vec3 = [0.34, 0.02, 0.46];
    const above: Vec3 = [spot[0], spot[1], spot[2] + 0.17];
    const mix = (a: Vec3, b: Vec3, k: number): Vec3 => [
      lerp(a[0], b[0], k),
      lerp(a[1], b[1], k),
      lerp(a[2], b[2], k),
    ];

    if (u < 0.26) return { target: mix(home, above, ease(u / 0.26)), grape: spot, grip: 0, holding: false };
    if (u < 0.4)
      return { target: mix(above, spot, ease((u - 0.26) / 0.14)), grape: spot, grip: 0, holding: false };
    if (u < 0.48) return { target: spot, grape: spot, grip: ease((u - 0.4) / 0.08), holding: false };
    if (u < 0.68) {
      const lifted = mix(spot, above, ease((u - 0.48) / 0.2));
      return { target: lifted, grape: lifted, grip: 1, holding: true };
    }
    if (u < 0.86) {
      const carried = mix(above, [drop[0], drop[1], drop[2] + 0.02], ease((u - 0.68) / 0.18));
      return { target: carried, grape: carried, grip: 1, holding: true };
    }
    const k = ease((u - 0.86) / 0.14);
    return {
      target: mix([drop[0], drop[1], drop[2] + 0.02], home, k),
      grape: drop,
      grip: 1 - k,
      holding: false,
    };
  }

  /**
   * Key light that orbits with the camera, so the face you're looking at stays
   * lit. A world-fixed light leaves the arm muddy from half the angles, which
   * is exactly the half the idle orbit spends its time in.
   */
  function keyLight(az: number): Vec3 {
    const base: Vec3 = [0.55, -0.45, 0.7];
    const c = Math.cos(-az);
    const sn = Math.sin(-az);
    return [base[0] * c - base[1] * sn, base[0] * sn + base[1] * c, base[2]];
  }

  interface Facet {
    depth: number;
    ax: number;
    ay: number;
    bx: number;
    by: number;
    cx: number;
    cy: number;
    shade: number;
  }

  /**
   * Rasterises the arm as flat-shaded triangles.
   *
   * Backface culling in screen space halves the work; the survivors are depth
   * sorted by centroid and painted far to near. At ~3.2k triangles that's
   * comfortably inside frame budget in canvas 2D, which is why the meshes were
   * decimated to this size rather than shipped whole.
   */
  function drawArm(
    ctx: CanvasRenderingContext2D,
    cam: Cam,
    angles: readonly number[],
    state: ArmState,
  ): void {
    const pose = armFK(angles);
    const light = keyLight(cam.az);

    // Bench grid.
    ctx.strokeStyle = 'rgba(120,150,215,0.08)';
    ctx.lineWidth = 1;
    const half = 0.85;
    for (let i = -5; i <= 5; i++) {
      const u = (i * half) / 5;
      const a1 = project([u, -half, 0], cam);
      const a2 = project([u, half, 0], cam);
      const b1 = project([-half, u, 0], cam);
      const b2 = project([half, u, 0], cam);
      ctx.beginPath();
      ctx.moveTo(a1.x, a1.y);
      ctx.lineTo(a2.x, a2.y);
      ctx.moveTo(b1.x, b1.y);
      ctx.lineTo(b2.x, b2.y);
      ctx.stroke();
    }

    const shadow = (world: Vec3, radius: number, alpha: number): void => {
      const s = project([world[0], world[1], 0], cam);
      const fade = clamp(1 - world[2] * 0.7, 0.25, 1);
      ctx.fillStyle = `rgba(0,0,0,${(alpha * fade).toFixed(3)})`;
      ctx.beginPath();
      ctx.ellipse(s.x, s.y, radius * s.k * fade, radius * s.k * fade * 0.34, 0, 0, Math.PI * 2);
      ctx.fill();
    };
    shadow(pose.tcp, 20, 0.3);
    shadow(state.grape, 9, 0.45);

    const facets: Facet[] = [];

    for (let li = 0; li < MESHES.length; li++) {
      const mesh = MESHES[li];
      const frame = pose.frames[li];
      if (!mesh || !frame) continue;
      const { R, p } = frame;

      // Transform this link's vertices into world space once per frame.
      const n = mesh.verts.length / 3;
      const wx = new Float32Array(n);
      const wy = new Float32Array(n);
      const wz = new Float32Array(n);
      const sx = new Float32Array(n);
      const sy = new Float32Array(n);
      const sd = new Float32Array(n);

      for (let i = 0; i < n; i++) {
        const x = mesh.verts[i * 3] ?? 0;
        const y = mesh.verts[i * 3 + 1] ?? 0;
        const z = mesh.verts[i * 3 + 2] ?? 0;
        const X = p[0] + (R[0] ?? 0) * x + (R[1] ?? 0) * y + (R[2] ?? 0) * z;
        const Y = p[1] + (R[3] ?? 0) * x + (R[4] ?? 0) * y + (R[5] ?? 0) * z;
        const Z = p[2] + (R[6] ?? 0) * x + (R[7] ?? 0) * y + (R[8] ?? 0) * z;
        wx[i] = X;
        wy[i] = Y;
        wz[i] = Z;
        const s = project([X, Y, Z], cam);
        sx[i] = s.x;
        sy[i] = s.y;
        sd[i] = s.depth;
      }

      for (let t = 0; t < mesh.tris.length; t += 3) {
        const ia = mesh.tris[t] ?? 0;
        const ib = mesh.tris[t + 1] ?? 0;
        const ic = mesh.tris[t + 2] ?? 0;

        const ax = sx[ia]!, ay = sy[ia]!;
        const bx = sx[ib]!, by = sy[ib]!;
        const cx2 = sx[ic]!, cy2 = sy[ic]!;

        // Screen-space winding: negative area faces away.
        const area = (bx - ax) * (cy2 - ay) - (by - ay) * (cx2 - ax);
        if (area <= 0) continue;

        // World normal for shading.
        const ux = wx[ib]! - wx[ia]!;
        const uy = wy[ib]! - wy[ia]!;
        const uz = wz[ib]! - wz[ia]!;
        const vx = wx[ic]! - wx[ia]!;
        const vy = wy[ic]! - wy[ia]!;
        const vz = wz[ic]! - wz[ia]!;
        let nx = uy * vz - uz * vy;
        let ny = uz * vx - ux * vz;
        let nz = ux * vy - uy * vx;
        const nl = Math.hypot(nx, ny, nz) || 1;
        nx /= nl;
        ny /= nl;
        nz /= nl;

        const lambert = Math.max(0, nx * light[0] + ny * light[1] + nz * light[2]);
        // Ambient floor keeps unlit faces from going flat black.
        const shade = 0.24 + 0.76 * lambert;

        facets.push({
          depth: (sd[ia]! + sd[ib]! + sd[ic]!) / 3,
          ax, ay, bx, by, cx: cx2, cy: cy2,
          shade,
        });
      }
    }

    facets.sort((a, b) => b.depth - a.depth);

    for (const f of facets) {
      const v = Math.round(214 * f.shade) + 30;
      ctx.fillStyle = `rgb(${v},${v + 4},${Math.min(255, v + 12)})`;
      ctx.beginPath();
      ctx.moveTo(f.ax, f.ay);
      ctx.lineTo(f.bx, f.by);
      ctx.lineTo(f.cx, f.cy);
      ctx.closePath();
      ctx.fill();
    }

    // Gripper fingers and the grape, on top of the mesh.
    const tcp = project(pose.tcp, cam);
    const wrist = project(pose.frames[pose.frames.length - 1]?.p ?? pose.tcp, cam);
    const dx = tcp.x - wrist.x;
    const dy = tcp.y - wrist.y;
    const l = Math.hypot(dx, dy) || 1;
    const px = -dy / l;
    const py = dx / l;
    const spread = (1 - state.grip) * 9 * tcp.k + 3 * tcp.k;
    const fl = 11 * tcp.k;
    ctx.strokeStyle = 'rgba(232,238,252,0.95)';
    ctx.lineWidth = Math.max(1.4, 3.2 * tcp.k);
    ctx.lineCap = 'round';
    for (const sign of [1, -1]) {
      ctx.beginPath();
      ctx.moveTo(tcp.x + px * spread * sign, tcp.y + py * spread * sign);
      ctx.lineTo(tcp.x + px * spread * sign + (dx / l) * fl, tcp.y + py * spread * sign + (dy / l) * fl);
      ctx.stroke();
    }

    const g = project(state.grape, cam);
    const r = Math.max(2.5, GRAPE_R * cam.zoom * g.k);
    const grad = ctx.createRadialGradient(g.x - r * 0.35, g.y - r * 0.4, r * 0.1, g.x, g.y, r * 1.15);
    grad.addColorStop(0, '#a86ec8');
    grad.addColorStop(0.5, '#6f3f9e');
    grad.addColorStop(1, '#3b1f5c');
    ctx.fillStyle = grad;
    ctx.beginPath();
    ctx.arc(g.x, g.y, r, 0, Math.PI * 2);
    ctx.fill();
    ctx.fillStyle = 'rgba(255,255,255,0.75)';
    ctx.beginPath();
    ctx.ellipse(g.x - r * 0.34, g.y - r * 0.42, r * 0.2, r * 0.14, -0.6, 0, Math.PI * 2);
    ctx.fill();
  }

  /* ------------------------------------------------------------- driver -- */

  function start(canvas: HTMLCanvasElement): void {
    const ctx = canvas.getContext('2d', { alpha: false });
    if (!ctx) return;

    const root = canvas.closest('.scene');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // ?scene=cars or ?scene=arm forces a scene, which makes it possible to
    // link to or screenshot a specific one. Otherwise it's a coin flip.
    const override = new URLSearchParams(location.search).get('scene');
    const requested = override ?? canvas.dataset.mode;
    const mode: 'cars' | 'arm' =
      requested === 'cars' || requested === 'arm'
        ? requested
        : Math.random() < 0.5
          ? 'cars'
          : 'arm';

    if (mode === 'cars') CLOUD = scanStreet();

    const stat = (slot: string, label: string, value: string): void => {
      const dt = root?.querySelector<HTMLElement>(`[data-label="${slot}"]`);
      const dd = root?.querySelector<HTMLElement>(`[data-stat="${slot}"]`);
      if (dt) dt.textContent = label;
      if (dd) dd.textContent = value;
    };

    if (mode === 'cars') {
      stat('a', 'Source', 'LiDAR');
      stat('b', 'Points', (CLOUD?.count ?? 0).toLocaleString('en-GB'));
      stat('c', 'Range', `${MAX_RANGE} m`);
    } else {
      stat('a', 'Model', MODEL_NAME);
      stat('b', 'Tris', TRIANGLES.toLocaleString('en-GB'));
      stat('c', 'Solver', 'CCD IK');
    }

    let az = mode === 'cars' ? -0.62 : -0.75;
    let el = mode === 'cars' ? 0.44 : 0.3;
    let t = 0;
    let raf = 0;
    let w = 0;
    let h = 0;
    const angles: number[] = [...REST];

    function resize(): void {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      const rect = canvas.getBoundingClientRect();
      w = rect.width;
      h = rect.height;
      canvas.width = Math.max(1, Math.round(w * dpr));
      canvas.height = Math.max(1, Math.round(h * dpr));
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function camera(): Cam {
      // Composed right of centre so the scene doesn't sit under the headline.
      const wide = w > 900;
      return mode === 'cars'
        ? {
            az,
            el,
            zoom: Math.min(w, h) / 15,
            cx: wide ? w * 0.66 : w * 0.5,
            cy: h * 0.58,
            persp: 0.014,
          }
        : {
            az,
            el,
            zoom: Math.min(w, h) * 0.5,
            cx: wide ? w * 0.68 : w * 0.5,
            cy: h * 0.74,
            persp: 0.16,
          };
    }

    function render(): void {
      if (!ctx) return;
      ctx.fillStyle = '#080a10';
      ctx.fillRect(0, 0, w, h);
      const cam = camera();
      if (mode === 'cars') {
        drawCars(ctx, w, h, cam);
      } else {
        armIK(angles, armScene(t).target, reduced ? 40 : 3);
        drawArm(ctx, cam, angles, armScene(t));
      }
    }

    let dragging = false;
    let lastX = 0;
    let lastY = 0;

    canvas.addEventListener('pointerdown', (e: PointerEvent) => {
      dragging = true;
      lastX = e.clientX;
      lastY = e.clientY;
      canvas.setPointerCapture(e.pointerId);
    });
    canvas.addEventListener('pointermove', (e: PointerEvent) => {
      if (!dragging) return;
      az -= (e.clientX - lastX) * 0.006;
      el = clamp(el + (e.clientY - lastY) * 0.004, 0.04, 1.1);
      lastX = e.clientX;
      lastY = e.clientY;
      if (reduced) render();
    });
    const endDrag = (e: PointerEvent): void => {
      dragging = false;
      if (canvas.hasPointerCapture(e.pointerId)) canvas.releasePointerCapture(e.pointerId);
    };
    canvas.addEventListener('pointerup', endDrag);
    canvas.addEventListener('pointercancel', endDrag);

    resize();
    new ResizeObserver(() => {
      resize();
      render();
    }).observe(canvas);

    if (reduced) {
      t = CYCLE * 0.42;
      render();
      return;
    }

    let last = performance.now();
    const loop = (now: number): void => {
      const dt = Math.min((now - last) / 1000, 0.05);
      last = now;
      t += dt;
      if (!dragging) az -= dt * (mode === 'cars' ? 0.05 : 0.07);
      render();
      raf = requestAnimationFrame(loop);
    };
    raf = requestAnimationFrame(loop);

    new IntersectionObserver((entries) => {
      const visible = entries[0]?.isIntersecting ?? false;
      if (visible && !raf) {
        last = performance.now();
        raf = requestAnimationFrame(loop);
      } else if (!visible && raf) {
        cancelAnimationFrame(raf);
        raf = 0;
      }
    }).observe(canvas);
  }

  document.querySelectorAll<HTMLCanvasElement>('canvas[data-hero-scene]').forEach(start);
</script>
