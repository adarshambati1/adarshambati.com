---
/**
 * Full-bleed 3D scene behind the hero. Text sits on top of the world rather
 * than beside it, so there's no hard divide.
 *
 * Picks one of two scenes per visit, 50/50:
 *
 *   scan — a real PandaSet LiDAR frame, streamed as a quantised binary.
 *   arm  — a Flexiv Rizon 4s relaying a grape between random stations, driven
 *          by operational-space control with the redundancy resolved in the
 *          nullspace.
 *
 * No overlay chrome: the scene is the whole thing. Drag to rotate, shift-drag
 * or shift-scroll to zoom, double-click to reset. Composed right-of-centre so
 * it doesn't sit under the headline.
 */
interface Props {
  /** Pin a scene instead of choosing at random. */
  mode?: 'auto' | 'scan' | 'arm';
}

const { mode = 'auto' } = Astro.props;
---

<div class="scene">
  <canvas class="scene__canvas" data-hero-scene data-mode={mode}></canvas>
</div>

<style>
  .scene {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .scene__canvas {
    display: block;
    width: 100%;
    height: 100%;
    cursor: grab;
    touch-action: none;
  }

  .scene__canvas:active {
    cursor: grabbing;
  }

</style>

<script>
  import { forward as armFK, stepOSC, MESHES, HOME } from '../lib/rizon';

  type Vec3 = [number, number, number];

  /* ---------------------------------------------------------------- math -- */

  // Matrix and kinematics helpers live in src/lib/rizon.ts alongside the model.
  const clamp = (v: number, lo: number, hi: number): number => Math.max(lo, Math.min(hi, v));
  const lerp = (a: number, b: number, t: number): number => a + (b - a) * t;
  /** Smoothstep, so approaches ease in and out. */
  const ease = (t: number): number => t * t * (3 - 2 * t);

  /* ------------------------------------------------------------- camera -- */

  interface Cam {
    az: number;
    el: number;
    zoom: number;
    cx: number;
    cy: number;
    /** Perspective falloff per unit depth. */
    persp: number;
  }

  interface Screen {
    x: number;
    y: number;
    depth: number;
    k: number;
  }

  function project(p: Vec3, cam: Cam): Screen {
    const ca = Math.cos(cam.az);
    const sa = Math.sin(cam.az);
    const x1 = p[0] * ca - p[1] * sa;
    const y1 = p[0] * sa + p[1] * ca;
    const ce = Math.cos(cam.el);
    const se = Math.sin(cam.el);
    const height = p[2] * ce - y1 * se;
    const depth = y1 * ce + p[2] * se;
    const k = 1 / (1 + depth * cam.persp);
    return { x: cam.cx + x1 * cam.zoom * k, y: cam.cy - height * cam.zoom * k, depth, k };
  }

  /* --------------------------------------------------------- point cloud -- */

  interface Cloud {
    xyz: Float32Array;
    rgb: Uint8Array;
    /** 1 = above the road surface. Objects draw larger and brighter. */
    kind: Uint8Array;
    count: number;
  }

  interface FrameInfo {
    id: string;
    sequence: string;
    frame: number;
    points: number;
    file: string;
  }

  /** Blue -> cyan -> green -> amber, the usual height ramp on scan viewers. */
  function ramp(t: number): [number, number, number] {
    const u = clamp(t, 0, 1);
    const stops: [number, [number, number, number]][] = [
      [0, [40, 82, 200]],
      [0.35, [38, 168, 224]],
      [0.62, [66, 212, 162]],
      [0.85, [224, 202, 92]],
      [1, [246, 148, 88]],
    ];
    for (let i = 0; i < stops.length - 1; i++) {
      const [p0, c0] = stops[i]!;
      const [p1, c1] = stops[i + 1]!;
      if (u <= p1) {
        const k = (u - p0) / (p1 - p0 || 1);
        return [
          Math.round(c0[0] + (c1[0] - c0[0]) * k),
          Math.round(c0[1] + (c1[1] - c0[1]) * k),
          Math.round(c0[2] + (c1[2] - c0[2]) * k),
        ];
      }
    }
    return stops[stops.length - 1]![1];
  }

  /** The scan that ships. The rest stay in the manifest for comparison. */
  const DEFAULT_FRAME = '092-20';

  let CLOUD: Cloud | null = null;

  /** Which frames exist, from the manifest the bake script writes. */
  async function loadManifest(): Promise<FrameInfo[]> {
    try {
      const res = await fetch('/data/lidar-frames.json');
      if (!res.ok) return [];
      const body = (await res.json()) as { frames?: FrameInfo[] };
      return body.frames ?? [];
    } catch {
      return [];
    }
  }

  /**
   * Decodes a baked scan.
   *
   * Layout: "LIDR", uint32 count, 3 floats origin, 3 floats scale, then
   * count*3 uint16 quantised xyz, then count uint8 intensity.
   */
  async function loadFrame(url: string): Promise<Cloud | null> {
    try {
      const res = await fetch(url);
      if (!res.ok) return null;
      const buf = await res.arrayBuffer();
      const view = new DataView(buf);
      const magic = String.fromCharCode(
        view.getUint8(0), view.getUint8(1), view.getUint8(2), view.getUint8(3),
      );
      if (magic !== 'LIDR') return null;

      const count = view.getUint32(4, true);
      const lo = [view.getFloat32(8, true), view.getFloat32(12, true), view.getFloat32(16, true)];
      const sc = [view.getFloat32(20, true), view.getFloat32(24, true), view.getFloat32(28, true)];

      const q = new Uint16Array(buf, 32, count * 3);
      const inten = new Uint8Array(buf, 32 + count * 6, count);

      const xyz = new Float32Array(count * 3);
      const rgb = new Uint8Array(count * 3);
      const kind = new Uint8Array(count);

      for (let i = 0; i < count; i++) {
        const x = lo[0]! + (q[i * 3] ?? 0) * sc[0]!;
        const y = lo[1]! + (q[i * 3 + 1] ?? 0) * sc[1]!;
        const z = lo[2]! + (q[i * 3 + 2] ?? 0) * sc[2]!;
        xyz[i * 3] = x;
        xyz[i * 3 + 1] = y;
        xyz[i * 3 + 2] = z;

        // Height ramp brightened by return intensity — that's what separates
        // road paint, plates and retroreflectors from everything else.
        const [r, g, b] = ramp((z + 2.2) / 5.2);
        const lift = 1.05 + ((inten[i] ?? 0) / 255) * 0.55;
        rgb[i * 3] = Math.min(255, Math.round(r * lift));
        rgb[i * 3 + 1] = Math.min(255, Math.round(g * lift));
        rgb[i * 3 + 2] = Math.min(255, Math.round(b * lift));
        kind[i] = z > -0.7 ? 1 : 0;
      }
      return { xyz, rgb, kind, count };
    } catch {
      return null;
    }
  }

  function drawCloud(ctx: CanvasRenderingContext2D, w: number, h: number, cam: Cam): void {
    const cloud = CLOUD;

    // Ground grid, drawn whether or not the points have arrived yet.
    ctx.strokeStyle = 'rgba(120,150,215,0.075)';
    ctx.lineWidth = 1;
    const span = 24;
    for (let g = -span; g <= span; g += 6) {
      for (const [a, b] of [
        [[g, -span, 0], [g, span, 0]],
        [[-span, g, 0], [span, g, 0]],
      ] as [Vec3, Vec3][]) {
        const p1 = project(a, cam);
        const p2 = project(b, cam);
        ctx.beginPath();
        ctx.moveTo(p1.x, p1.y);
        ctx.lineTo(p2.x, p2.y);
        ctx.stroke();
      }
    }
    if (!cloud) return;

    for (let i = 0; i < cloud.count; i++) {
      const p = project(
        [cloud.xyz[i * 3]!, cloud.xyz[i * 3 + 1]!, cloud.xyz[i * 3 + 2]!],
        cam,
      );
      if (p.k <= 0 || p.x < -4 || p.x > w + 4 || p.y < -4 || p.y > h + 4) continue;
      const object = cloud.kind[i] === 1;
      const size = object ? (p.k > 0.7 ? 2.6 : 2.1) : p.k > 0.8 ? 1.8 : 1.4;
      const alpha = object ? 0.8 + p.k * 0.2 : 0.46 + p.k * 0.4;
      ctx.fillStyle = `rgba(${cloud.rgb[i * 3]},${cloud.rgb[i * 3 + 1]},${cloud.rgb[i * 3 + 2]},${alpha.toFixed(2)})`;
      ctx.fillRect(p.x, p.y, size, size);
    }

    // Sensor origin.
    const origin = project([0, 0, 1.9], cam);
    ctx.fillStyle = 'rgba(235,244,255,0.95)';
    ctx.beginPath();
    ctx.arc(origin.x, origin.y, 2.6, 0, Math.PI * 2);
    ctx.fill();
  }

  /* ----------------------------------------------------------- arm scene -- */

  /**
   * Real Flexiv Rizon 4s: decimated visual meshes and the kinematic chain from
   * flexiv_description (Apache-2.0), via src/lib/rizon.ts.
   */
  const REST: readonly number[] = [...HOME];
  const GRAPE_R = 0.028;
  const HOVER = 0.18;
  const CYCLE = 6.4;

  /**
   * A pseudo-random but reproducible station for cycle n.
   *
   * Reproducible matters: the safety test drives the same sequence, so a pose
   * that passes there is the pose that ships. Placements stay inside a forward
   * arc and an annulus the arm can reach comfortably — sampling the full circle
   * would put grapes behind the base where joint 1 can't follow.
   */
  function station(n: number): Vec3 {
    let h = Math.imul(n + 1, 2654435761) >>> 0;
    const rand = (): number => {
      h ^= h << 13;
      h ^= h >>> 17;
      h ^= h << 5;
      h >>>= 0;
      return h / 4294967296;
    };
    const bearing = (rand() - 0.5) * 2.6;
    const reach = 0.34 + rand() * 0.19;
    return [Math.cos(bearing) * reach, Math.sin(bearing) * reach, GRAPE_R];
  }

  interface ArmState {
    target: Vec3;
    grape: Vec3;
    grip: number;
    holding: boolean;
  }

  /**
   * One cycle carries the grape from where it was last set down to a fresh
   * station, ending with the gripper hovering over the destination — which is
   * where the next cycle begins. The grape is therefore always either resting
   * where it was placed or held in the gripper; it never teleports.
   */
  function armScene(t: number): ArmState {
    const n = Math.floor(t / CYCLE);
    const u = (t % CYCLE) / CYCLE;

    const from = station(n);
    const to = station(n + 1);
    const overFrom: Vec3 = [from[0], from[1], from[2] + HOVER];
    const overTo: Vec3 = [to[0], to[1], to[2] + HOVER];

    const mix = (a: Vec3, b: Vec3, k: number): Vec3 => [
      lerp(a[0], b[0], k),
      lerp(a[1], b[1], k),
      lerp(a[2], b[2], k),
    ];

    if (u < 0.14) {
      return { target: mix(overFrom, from, ease(u / 0.14)), grape: from, grip: 0, holding: false };
    }
    if (u < 0.22) {
      return { target: from, grape: from, grip: ease((u - 0.14) / 0.08), holding: false };
    }
    if (u < 0.36) {
      const p = mix(from, overFrom, ease((u - 0.22) / 0.14));
      return { target: p, grape: p, grip: 1, holding: true };
    }
    if (u < 0.64) {
      const p = mix(overFrom, overTo, ease((u - 0.36) / 0.28));
      return { target: p, grape: p, grip: 1, holding: true };
    }
    if (u < 0.78) {
      const p = mix(overTo, to, ease((u - 0.64) / 0.14));
      return { target: p, grape: p, grip: 1, holding: true };
    }
    if (u < 0.86) {
      return { target: to, grape: to, grip: 1 - ease((u - 0.78) / 0.08), holding: false };
    }
    return {
      target: mix(to, overTo, ease((u - 0.86) / 0.14)),
      grape: to,
      grip: 0,
      holding: false,
    };
  }

  /**
   * Key light that orbits with the camera, so the face you're looking at stays
   * lit. A world-fixed light leaves the arm muddy from half the angles, which
   * is exactly the half the idle orbit spends its time in.
   */
  function keyLight(az: number): Vec3 {
    const base: Vec3 = [0.55, -0.45, 0.7];
    const c = Math.cos(-az);
    const sn = Math.sin(-az);
    return [base[0] * c - base[1] * sn, base[0] * sn + base[1] * c, base[2]];
  }

  interface Facet {
    depth: number;
    ax: number;
    ay: number;
    bx: number;
    by: number;
    cx: number;
    cy: number;
    shade: number;
  }

  /**
   * Rasterises the arm as flat-shaded triangles.
   *
   * Backface culling in screen space halves the work; the survivors are depth
   * sorted by centroid and painted far to near. At ~3.2k triangles that's
   * comfortably inside frame budget in canvas 2D, which is why the meshes were
   * decimated to this size rather than shipped whole.
   */
  function drawArm(
    ctx: CanvasRenderingContext2D,
    cam: Cam,
    angles: readonly number[],
    state: ArmState,
  ): void {
    const pose = armFK(angles);
    const light = keyLight(cam.az);

    // Bench grid.
    ctx.strokeStyle = 'rgba(120,150,215,0.08)';
    ctx.lineWidth = 1;
    const half = 0.85;
    for (let i = -5; i <= 5; i++) {
      const u = (i * half) / 5;
      const a1 = project([u, -half, 0], cam);
      const a2 = project([u, half, 0], cam);
      const b1 = project([-half, u, 0], cam);
      const b2 = project([half, u, 0], cam);
      ctx.beginPath();
      ctx.moveTo(a1.x, a1.y);
      ctx.lineTo(a2.x, a2.y);
      ctx.moveTo(b1.x, b1.y);
      ctx.lineTo(b2.x, b2.y);
      ctx.stroke();
    }

    const shadow = (world: Vec3, radius: number, alpha: number): void => {
      const s = project([world[0], world[1], 0], cam);
      const fade = clamp(1 - world[2] * 0.7, 0.25, 1);
      ctx.fillStyle = `rgba(0,0,0,${(alpha * fade).toFixed(3)})`;
      ctx.beginPath();
      ctx.ellipse(s.x, s.y, radius * s.k * fade, radius * s.k * fade * 0.34, 0, 0, Math.PI * 2);
      ctx.fill();
    };
    shadow(pose.tcp, 20, 0.3);
    // Same position the grape is actually drawn at, or its shadow drifts free
    // of it while the tool is trailing its setpoint.
    shadow(state.holding ? pose.tcp : state.grape, 9, 0.45);

    const facets: Facet[] = [];

    for (let li = 0; li < MESHES.length; li++) {
      const mesh = MESHES[li];
      const frame = pose.frames[li];
      if (!mesh || !frame) continue;
      const { R, p } = frame;

      // Transform this link's vertices into world space once per frame.
      const n = mesh.verts.length / 3;
      const wx = new Float32Array(n);
      const wy = new Float32Array(n);
      const wz = new Float32Array(n);
      const sx = new Float32Array(n);
      const sy = new Float32Array(n);
      const sd = new Float32Array(n);

      for (let i = 0; i < n; i++) {
        const x = mesh.verts[i * 3] ?? 0;
        const y = mesh.verts[i * 3 + 1] ?? 0;
        const z = mesh.verts[i * 3 + 2] ?? 0;
        const X = p[0] + (R[0] ?? 0) * x + (R[1] ?? 0) * y + (R[2] ?? 0) * z;
        const Y = p[1] + (R[3] ?? 0) * x + (R[4] ?? 0) * y + (R[5] ?? 0) * z;
        const Z = p[2] + (R[6] ?? 0) * x + (R[7] ?? 0) * y + (R[8] ?? 0) * z;
        wx[i] = X;
        wy[i] = Y;
        wz[i] = Z;
        const s = project([X, Y, Z], cam);
        sx[i] = s.x;
        sy[i] = s.y;
        sd[i] = s.depth;
      }

      for (let t = 0; t < mesh.tris.length; t += 3) {
        const ia = mesh.tris[t] ?? 0;
        const ib = mesh.tris[t + 1] ?? 0;
        const ic = mesh.tris[t + 2] ?? 0;

        const ax = sx[ia]!, ay = sy[ia]!;
        const bx = sx[ib]!, by = sy[ib]!;
        const cx2 = sx[ic]!, cy2 = sy[ic]!;

        // Screen-space winding: negative area faces away.
        const area = (bx - ax) * (cy2 - ay) - (by - ay) * (cx2 - ax);
        if (area <= 0) continue;

        // World normal for shading.
        const ux = wx[ib]! - wx[ia]!;
        const uy = wy[ib]! - wy[ia]!;
        const uz = wz[ib]! - wz[ia]!;
        const vx = wx[ic]! - wx[ia]!;
        const vy = wy[ic]! - wy[ia]!;
        const vz = wz[ic]! - wz[ia]!;
        let nx = uy * vz - uz * vy;
        let ny = uz * vx - ux * vz;
        let nz = ux * vy - uy * vx;
        const nl = Math.hypot(nx, ny, nz) || 1;
        nx /= nl;
        ny /= nl;
        nz /= nl;

        const lambert = Math.max(0, nx * light[0] + ny * light[1] + nz * light[2]);
        // Ambient floor keeps unlit faces from going flat black.
        const shade = 0.24 + 0.76 * lambert;

        facets.push({
          depth: (sd[ia]! + sd[ib]! + sd[ic]!) / 3,
          ax, ay, bx, by, cx: cx2, cy: cy2,
          shade,
        });
      }
    }

    facets.sort((a, b) => b.depth - a.depth);

    for (const f of facets) {
      const v = Math.round(214 * f.shade) + 30;
      ctx.fillStyle = `rgb(${v},${v + 4},${Math.min(255, v + 12)})`;
      ctx.beginPath();
      ctx.moveTo(f.ax, f.ay);
      ctx.lineTo(f.bx, f.by);
      ctx.lineTo(f.cx, f.cy);
      ctx.closePath();
      ctx.fill();
    }

    // Gripper fingers and the grape, on top of the mesh.
    const tcp = project(pose.tcp, cam);
    const wrist = project(pose.frames[pose.frames.length - 1]?.p ?? pose.tcp, cam);
    const dx = tcp.x - wrist.x;
    const dy = tcp.y - wrist.y;
    const l = Math.hypot(dx, dy) || 1;
    const px = -dy / l;
    const py = dx / l;
    const spread = (1 - state.grip) * 9 * tcp.k + 3 * tcp.k;
    const fl = 11 * tcp.k;
    ctx.strokeStyle = 'rgba(232,238,252,0.95)';
    ctx.lineWidth = Math.max(1.4, 3.2 * tcp.k);
    ctx.lineCap = 'round';
    for (const sign of [1, -1]) {
      ctx.beginPath();
      ctx.moveTo(tcp.x + px * spread * sign, tcp.y + py * spread * sign);
      ctx.lineTo(tcp.x + px * spread * sign + (dx / l) * fl, tcp.y + py * spread * sign + (dy / l) * fl);
      ctx.stroke();
    }

    // While held, the grape rides the actual tool, not the commanded target.
    // The controller trails its setpoint during fast moves — that lag is what
    // makes the motion look weighted — so drawing the grape at the target
    // leaves it floating off the gripper.
    const grapeWorld: Vec3 = state.holding ? pose.tcp : state.grape;
    const g = project(grapeWorld, cam);
    const r = Math.max(2.5, GRAPE_R * cam.zoom * g.k);
    const grad = ctx.createRadialGradient(g.x - r * 0.35, g.y - r * 0.4, r * 0.1, g.x, g.y, r * 1.15);
    grad.addColorStop(0, '#a86ec8');
    grad.addColorStop(0.5, '#6f3f9e');
    grad.addColorStop(1, '#3b1f5c');
    ctx.fillStyle = grad;
    ctx.beginPath();
    ctx.arc(g.x, g.y, r, 0, Math.PI * 2);
    ctx.fill();
    ctx.fillStyle = 'rgba(255,255,255,0.75)';
    ctx.beginPath();
    ctx.ellipse(g.x - r * 0.34, g.y - r * 0.42, r * 0.2, r * 0.14, -0.6, 0, Math.PI * 2);
    ctx.fill();
  }

  /* ------------------------------------------------------------- driver -- */

  function start(canvas: HTMLCanvasElement): void {
    const ctx = canvas.getContext('2d', { alpha: false });
    if (!ctx) return;

    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // ?scene=cars or ?scene=arm forces a scene, which makes it possible to
    // link to or screenshot a specific one. Otherwise it's a coin flip.
    const override = new URLSearchParams(location.search).get('scene');
    const requested = override ?? canvas.dataset.mode;
    // 'real' and 'cars' are kept as aliases so old links don't break.
    const alias: Record<string, 'scan' | 'arm'> = {
      real: 'scan',
      cars: 'scan',
      scan: 'scan',
      arm: 'arm',
    };
    const resolved = requested ? alias[requested] : undefined;
    const mode: 'scan' | 'arm' = resolved ?? (Math.random() < 0.5 ? 'scan' : 'arm');


    if (mode === 'scan') {
      // Async: the grid draws immediately, points appear when they land.
      void (async () => {
        const frames = await loadManifest();
        if (frames.length === 0) return;
        // One fixed scan ships. ?frame=<id> still overrides, so the others in
        // the manifest can be compared without a rebuild.
        const want = new URLSearchParams(location.search).get('frame');
        const picked =
          frames.find((f) => f.id === want) ??
          frames.find((f) => f.id === DEFAULT_FRAME) ??
          frames[0]!;
        CLOUD = await loadFrame(picked.file);
      })();
    }

    let az = mode === 'arm' ? -0.75 : -0.62;
    /** User zoom multiplier on top of the scene's base scale. */
    let zoomFactor = 1;
    let el = mode === 'arm' ? 0.3 : 0.5;
    let t = 0;
    let raf = 0;
    let w = 0;
    let h = 0;
    const angles: number[] = [...REST];
    // Settle onto the first target before the first frame. Otherwise the arm
    // opens with a long swoop down from the home pose and spends the first
    // cycle catching up to a target that's already moving.
    if (mode === 'arm') {
      for (let i = 0; i < 600; i++) stepOSC(angles, armScene(0).target, 1 / 60);
    }

    function resize(): void {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      const rect = canvas.getBoundingClientRect();
      w = rect.width;
      h = rect.height;
      canvas.width = Math.max(1, Math.round(w * dpr));
      canvas.height = Math.max(1, Math.round(h * dpr));
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function camera(): Cam {
      // Composed right of centre so the scene doesn't sit under the headline.
      const wide = w > 900;
      return mode === 'scan'
        ? {
            az,
            el,
            zoom: (Math.min(w, h) / 34) * zoomFactor,
            cx: wide ? w * 0.66 : w * 0.5,
            cy: h * 0.58,
            persp: 0.014,
          }
        : {
            az,
            el,
            zoom: Math.min(w, h) * 0.5 * zoomFactor,
            cx: wide ? w * 0.68 : w * 0.5,
            cy: h * 0.74,
            persp: 0.16,
          };
    }

    /** `dt` drives the OSC integration; the default suits one-off redraws. */
    function render(dt: number = 1 / 60): void {
      if (!ctx) return;
      ctx.fillStyle = '#080a10';
      ctx.fillRect(0, 0, w, h);
      const cam = camera();
      if (mode === 'scan') {
        drawCloud(ctx, w, h, cam);
      } else {
        const state = armScene(t);
        stepOSC(angles, state.target, dt);
        drawArm(ctx, cam, angles, state);
      }
    }

    let dragging = false;
    let lastX = 0;
    let lastY = 0;

    canvas.addEventListener('pointerdown', (e: PointerEvent) => {
      dragging = true;
      lastX = e.clientX;
      lastY = e.clientY;
      canvas.setPointerCapture(e.pointerId);
    });
    canvas.addEventListener('pointermove', (e: PointerEvent) => {
      if (!dragging) return;
      const dx = e.clientX - lastX;
      const dy = e.clientY - lastY;

      if (e.shiftKey) {
        // Shift-drag zooms instead of orbiting.
        zoomFactor = clamp(zoomFactor * Math.exp(-dy * 0.004), 0.4, 5);
      } else {
        az -= dx * 0.006;
        el = clamp(el + dy * 0.004, 0.04, 1.1);
      }

      lastX = e.clientX;
      lastY = e.clientY;
      if (reduced) render();
    });

    // Shift + wheel zooms too. Without the modifier the wheel keeps scrolling
    // the page — hijacking it on a full-viewport hero would trap the reader.
    canvas.addEventListener(
      'wheel',
      (e: WheelEvent) => {
        if (!e.shiftKey) return;
        e.preventDefault();
        zoomFactor = clamp(zoomFactor * Math.exp(-e.deltaY * 0.0015), 0.4, 5);
        if (reduced) render();
      },
      { passive: false },
    );

    // Double-click resets the view.
    canvas.addEventListener('dblclick', () => {
      zoomFactor = 1;
      el = mode === 'arm' ? 0.3 : 0.5;
      if (reduced) render();
    });
    const endDrag = (e: PointerEvent): void => {
      dragging = false;
      if (canvas.hasPointerCapture(e.pointerId)) canvas.releasePointerCapture(e.pointerId);
    };
    canvas.addEventListener('pointerup', endDrag);
    canvas.addEventListener('pointercancel', endDrag);

    resize();
    new ResizeObserver(() => {
      resize();
      render();
    }).observe(canvas);

    if (reduced) {
      t = CYCLE * 0.5;
      // Converge to the pose before drawing it once.
      for (let i = 0; i < 400; i++) stepOSC(angles, armScene(t).target, 1 / 60);
      render();
      return;
    }

    let last = performance.now();
    const loop = (now: number): void => {
      const dt = Math.min((now - last) / 1000, 0.05);
      last = now;
      t += dt;

      // Idle orbit, paused while the user is driving it. The scan turns at
      // roughly two minutes per revolution — enough to read as movement
      // without becoming a carousel.
      if (!dragging) az -= dt * (mode === 'arm' ? 0.07 : 0.052);

      render(dt);
      raf = requestAnimationFrame(loop);
    };
    raf = requestAnimationFrame(loop);

    new IntersectionObserver((entries) => {
      const visible = entries[0]?.isIntersecting ?? false;
      if (visible && !raf) {
        last = performance.now();
        raf = requestAnimationFrame(loop);
      } else if (!visible && raf) {
        cancelAnimationFrame(raf);
        raf = 0;
      }
    }).observe(canvas);
  }

  document.querySelectorAll<HTMLCanvasElement>('canvas[data-hero-scene]').forEach(start);
</script>
