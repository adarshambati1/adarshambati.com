---
/**
 * Full-bleed 3D scene behind the hero. Text sits on top of the world rather
 * than beside it, so there's no hard divide.
 *
 * Picks one of two scenes per visit, 50/50:
 *
 *   cars — a LiDAR point cloud of a street, ray-cast from a simulated spinning
 *          multi-beam sensor against a ground plane and oriented boxes. The
 *          rings, the shadows behind vehicles and the gap under each car all
 *          fall out of the cast; none of it is drawn by hand.
 *   arm  — a 7-DOF Kinova-style manipulator picking a grape, running forward
 *          kinematics with CCD inverse kinematics onto the target.
 *
 * Both are drag-to-rotate. The scene is composed right-of-centre so it doesn't
 * sit under the headline.
 */
interface Props {
  /** Pin a scene instead of choosing at random. */
  mode?: 'auto' | 'cars' | 'arm';
}

const { mode = 'auto' } = Astro.props;
---

<div class="scene">
  <canvas class="scene__canvas" data-hero-scene data-mode={mode}></canvas>

  <span class="scene__tick scene__tick--tr" aria-hidden="true"></span>
  <span class="scene__tick scene__tick--br" aria-hidden="true"></span>

  <dl class="scene__readout" aria-hidden="true">
    <div><dt data-label="a">Source</dt><dd data-stat="a">—</dd></div>
    <div><dt data-label="b">Points</dt><dd data-stat="b">—</dd></div>
    <div><dt data-label="c">Range</dt><dd data-stat="c">—</dd></div>
  </dl>

  <p class="scene__hint" aria-hidden="true">drag to rotate</p>
</div>

<style>
  .scene {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .scene__canvas {
    display: block;
    width: 100%;
    height: 100%;
    cursor: grab;
    touch-action: none;
  }

  .scene__canvas:active {
    cursor: grabbing;
  }

  .scene__tick {
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: rgba(160, 180, 225, 0.4);
    border-style: solid;
    pointer-events: none;
  }

  .scene__tick--tr {
    top: calc(var(--header-height) + 20px);
    right: 24px;
    border-width: 1px 1px 0 0;
  }

  .scene__tick--br {
    right: 24px;
    bottom: 24px;
    border-width: 0 1px 1px 0;
  }

  .scene__readout {
    position: absolute;
    right: 24px;
    top: calc(var(--header-height) + 44px);
    display: grid;
    gap: 0.3rem;
    margin: 0;
    padding: 0.7rem 0.85rem;
    font-size: 0.6875rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: rgba(190, 205, 235, 0.75);
    background: rgba(8, 10, 16, 0.5);
    border: 1px solid rgba(160, 180, 225, 0.16);
    border-radius: 6px;
    backdrop-filter: blur(4px);
    pointer-events: none;
  }

  .scene__readout div {
    display: flex;
    justify-content: space-between;
    gap: 1.75rem;
  }

  .scene__readout dt {
    color: rgba(150, 168, 205, 0.7);
  }

  .scene__readout dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
    color: rgba(215, 228, 255, 0.95);
  }

  .scene__hint {
    position: absolute;
    right: 24px;
    bottom: 48px;
    margin: 0;
    font-size: 0.6875rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: rgba(160, 180, 225, 0.45);
    pointer-events: none;
  }

  @media (max-width: 52rem) {
    .scene__readout,
    .scene__hint,
    .scene__tick {
      display: none;
    }
  }
</style>

<script>
  type Vec3 = [number, number, number];
  type Mat3 = number[];

  /* ---------------------------------------------------------------- math -- */

  const IDENTITY: Mat3 = [1, 0, 0, 0, 1, 0, 0, 0, 1];

  function mul(a: Mat3, b: Mat3): Mat3 {
    const out = new Array<number>(9).fill(0);
    for (let r = 0; r < 3; r++) {
      for (let c = 0; c < 3; c++) {
        out[r * 3 + c] =
          (a[r * 3] ?? 0) * (b[c] ?? 0) +
          (a[r * 3 + 1] ?? 0) * (b[3 + c] ?? 0) +
          (a[r * 3 + 2] ?? 0) * (b[6 + c] ?? 0);
      }
    }
    return out;
  }

  const applyM = (m: Mat3, v: Vec3): Vec3 => [
    (m[0] ?? 0) * v[0] + (m[1] ?? 0) * v[1] + (m[2] ?? 0) * v[2],
    (m[3] ?? 0) * v[0] + (m[4] ?? 0) * v[1] + (m[5] ?? 0) * v[2],
    (m[6] ?? 0) * v[0] + (m[7] ?? 0) * v[1] + (m[8] ?? 0) * v[2],
  ];

  const rotZ = (t: number): Mat3 => {
    const c = Math.cos(t);
    const s = Math.sin(t);
    return [c, -s, 0, s, c, 0, 0, 0, 1];
  };
  const rotY = (t: number): Mat3 => {
    const c = Math.cos(t);
    const s = Math.sin(t);
    return [c, 0, s, 0, 1, 0, -s, 0, c];
  };

  const sub = (a: Vec3, b: Vec3): Vec3 => [a[0] - b[0], a[1] - b[1], a[2] - b[2]];
  const dot = (a: Vec3, b: Vec3): number => a[0] * b[0] + a[1] * b[1] + a[2] * b[2];
  const cross = (a: Vec3, b: Vec3): Vec3 => [
    a[1] * b[2] - a[2] * b[1],
    a[2] * b[0] - a[0] * b[2],
    a[0] * b[1] - a[1] * b[0],
  ];
  const len3 = (a: Vec3): number => Math.hypot(a[0], a[1], a[2]);
  const norm = (a: Vec3): Vec3 => {
    const l = len3(a);
    return l < 1e-9 ? [0, 0, 0] : [a[0] / l, a[1] / l, a[2] / l];
  };
  const clamp = (v: number, lo: number, hi: number): number => Math.max(lo, Math.min(hi, v));
  const lerp = (a: number, b: number, t: number): number => a + (b - a) * t;
  const ease = (t: number): number => t * t * (3 - 2 * t);

  /* ------------------------------------------------------------- camera -- */

  interface Cam {
    az: number;
    el: number;
    zoom: number;
    cx: number;
    cy: number;
    /** Perspective falloff per unit depth. */
    persp: number;
  }

  interface Screen {
    x: number;
    y: number;
    depth: number;
    k: number;
  }

  function project(p: Vec3, cam: Cam): Screen {
    const ca = Math.cos(cam.az);
    const sa = Math.sin(cam.az);
    const x1 = p[0] * ca - p[1] * sa;
    const y1 = p[0] * sa + p[1] * ca;
    const ce = Math.cos(cam.el);
    const se = Math.sin(cam.el);
    const height = p[2] * ce - y1 * se;
    const depth = y1 * ce + p[2] * se;
    const k = 1 / (1 + depth * cam.persp);
    return { x: cam.cx + x1 * cam.zoom * k, y: cam.cy - height * cam.zoom * k, depth, k };
  }

  /* ----------------------------------------------------------- car scene -- */

  interface Box {
    cx: number;
    cy: number;
    z0: number;
    z1: number;
    hx: number;
    hy: number;
    yaw: number;
  }

  /** A car as two stacked boxes: body, then a shorter inset cabin. */
  function car(cx: number, cy: number, yaw: number, scale = 1): Box[] {
    const l = 4.5 * scale;
    const w = 1.85 * scale;
    return [
      { cx, cy, z0: 0.28, z1: 0.95, hx: l / 2, hy: w / 2, yaw },
      { cx, cy, z0: 0.95, z1: 1.5, hx: l * 0.27, hy: w * 0.44, yaw },
    ];
  }

  const BOXES: Box[] = [
    ...car(6.2, 2.9, 0.02),
    ...car(13.5, 3.1, -0.03),
    ...car(20.5, 2.9, 0.015),
    ...car(8.5, -3.0, Math.PI),
    ...car(16.5, -3.2, Math.PI + 0.04),
    ...car(-6.5, -2.9, Math.PI),
    ...car(-12, 3.0, 0.02),
    ...car(3.4, 6.4, 0.44, 1.22),
  ];

  const SENSOR_H = 1.9;
  const BEAMS = 26;
  const AZIMUTH_STEPS = 680;
  const MAX_RANGE = 27;

  function hitBox(o: Vec3, d: Vec3, b: Box): number {
    const c = Math.cos(-b.yaw);
    const s = Math.sin(-b.yaw);
    const ox = (o[0] - b.cx) * c - (o[1] - b.cy) * s;
    const oy = (o[0] - b.cx) * s + (o[1] - b.cy) * c;
    const dx = d[0] * c - d[1] * s;
    const dy = d[0] * s + d[1] * c;

    let tmin = 0;
    let tmax = MAX_RANGE;
    const slab = (start: number, dir: number, lo: number, hi: number): boolean => {
      if (Math.abs(dir) < 1e-9) return start >= lo && start <= hi;
      let t0 = (lo - start) / dir;
      let t1 = (hi - start) / dir;
      if (t0 > t1) [t0, t1] = [t1, t0];
      tmin = Math.max(tmin, t0);
      tmax = Math.min(tmax, t1);
      return tmax >= tmin;
    };

    if (!slab(ox, dx, -b.hx, b.hx)) return Infinity;
    if (!slab(oy, dy, -b.hy, b.hy)) return Infinity;
    if (!slab(o[2], d[2], b.z0, b.z1)) return Infinity;
    return tmin > 0.05 ? tmin : Infinity;
  }

  interface Cloud {
    xyz: Float32Array;
    rgb: Uint8Array;
    /** 1 = vehicle. Vehicles draw larger and brighter than road. */
    kind: Uint8Array;
    count: number;
  }

  function ramp(t: number): [number, number, number] {
    const u = clamp(t, 0, 1);
    const stops: [number, [number, number, number]][] = [
      [0, [40, 82, 200]],
      [0.35, [38, 168, 224]],
      [0.62, [66, 212, 162]],
      [0.85, [224, 202, 92]],
      [1, [246, 148, 88]],
    ];
    for (let i = 0; i < stops.length - 1; i++) {
      const [p0, c0] = stops[i]!;
      const [p1, c1] = stops[i + 1]!;
      if (u <= p1) {
        const k = (u - p0) / (p1 - p0 || 1);
        return [
          Math.round(c0[0] + (c1[0] - c0[0]) * k),
          Math.round(c0[1] + (c1[1] - c0[1]) * k),
          Math.round(c0[2] + (c1[2] - c0[2]) * k),
        ];
      }
    }
    return stops[stops.length - 1]![1];
  }

  /** One revolution of the sensor, cast against the scene. Runs once. */
  function scanStreet(): Cloud {
    const cap = BEAMS * AZIMUTH_STEPS;
    const xyz = new Float32Array(cap * 3);
    const rgb = new Uint8Array(cap * 3);
    const kind = new Uint8Array(cap);
    const origin: Vec3 = [0, 0, SENSOR_H];
    const elMin = (-23 * Math.PI) / 180;
    const elMax = (2.5 * Math.PI) / 180;
    let n = 0;

    for (let b = 0; b < BEAMS; b++) {
      const el = elMin + ((elMax - elMin) * b) / (BEAMS - 1);
      const ce = Math.cos(el);
      const se = Math.sin(el);

      for (let a = 0; a < AZIMUTH_STEPS; a++) {
        const az = (a / AZIMUTH_STEPS) * Math.PI * 2;
        const dir: Vec3 = [Math.cos(az) * ce, Math.sin(az) * ce, se];

        let best = dir[2] < -1e-6 ? -origin[2] / dir[2] : Infinity;
        let vehicle = false;
        for (const box of BOXES) {
          const t = hitBox(origin, dir, box);
          if (t < best) {
            best = t;
            vehicle = true;
          }
        }
        if (!Number.isFinite(best) || best > MAX_RANGE) continue;

        const px = origin[0] + dir[0] * best;
        const py = origin[1] + dir[1] * best;
        const pz = origin[2] + dir[2] * best;
        xyz[n * 3] = px;
        xyz[n * 3 + 1] = py;
        xyz[n * 3 + 2] = pz;

        const [r, g, bb] = ramp(pz / 2.0);
        // Vehicles read hotter than road so the shapes separate.
        kind[n] = vehicle ? 1 : 0;
        const lift = vehicle ? 1.25 : 0.82;
        rgb[n * 3] = Math.min(255, Math.round(r * lift));
        rgb[n * 3 + 1] = Math.min(255, Math.round(g * lift));
        rgb[n * 3 + 2] = Math.min(255, Math.round(bb * lift));
        n++;
      }
    }
    return { xyz, rgb, kind, count: n };
  }

  let CLOUD: Cloud | null = null;

  function drawCars(ctx: CanvasRenderingContext2D, w: number, h: number, cam: Cam): void {
    const cloud = CLOUD!;

    // Ground grid under the points, for scale.
    ctx.strokeStyle = 'rgba(120,150,215,0.075)';
    ctx.lineWidth = 1;
    const span = 30;
    for (let g = -span; g <= span; g += 6) {
      for (const [a, b] of [
        [
          [g, -span, 0],
          [g, span, 0],
        ],
        [
          [-span, g, 0],
          [span, g, 0],
        ],
      ] as [Vec3, Vec3][]) {
        const p1 = project(a, cam);
        const p2 = project(b, cam);
        ctx.beginPath();
        ctx.moveTo(p1.x, p1.y);
        ctx.lineTo(p2.x, p2.y);
        ctx.stroke();
      }
    }

    for (let i = 0; i < cloud.count; i++) {
      const p = project(
        [cloud.xyz[i * 3]!, cloud.xyz[i * 3 + 1]!, cloud.xyz[i * 3 + 2]!],
        cam,
      );
      if (p.k <= 0 || p.x < -4 || p.x > w + 4 || p.y < -4 || p.y > h + 4) continue;
      const isVehicle = cloud.kind[i] === 1;
      const size = isVehicle ? (p.k > 0.7 ? 2.6 : 2) : p.k > 0.8 ? 1.6 : 1.2;
      const alpha = isVehicle ? 0.62 + p.k * 0.38 : 0.22 + p.k * 0.34;
      ctx.fillStyle = `rgba(${cloud.rgb[i * 3]},${cloud.rgb[i * 3 + 1]},${cloud.rgb[i * 3 + 2]},${alpha.toFixed(2)})`;
      ctx.fillRect(p.x, p.y, size, size);
    }

    const origin = project([0, 0, SENSOR_H], cam);
    ctx.fillStyle = 'rgba(235,244,255,0.95)';
    ctx.beginPath();
    ctx.arc(origin.x, origin.y, 2.6, 0, Math.PI * 2);
    ctx.fill();
  }

  /* ----------------------------------------------------------- arm scene -- */

  const LINKS: readonly number[] = [0.16, 0.13, 0.22, 0.2, 0.18, 0.1, 0.09];
  const AXES: readonly ('z' | 'y')[] = ['z', 'y', 'z', 'y', 'z', 'y', 'z'];
  const LIMITS: readonly [number, number][] = [
    [-Math.PI, Math.PI],
    [-2.2, 2.2],
    [-Math.PI, Math.PI],
    [-2.5, 2.5],
    [-Math.PI, Math.PI],
    [-2.2, 2.2],
    [-Math.PI, Math.PI],
  ];
  const REST: readonly number[] = [0.35, 0.75, 0, -1.1, 0, 0.7, 0];
  const GRAPE_R = 0.032;
  const SPOTS: readonly Vec3[] = [
    [0.34, 0.22, GRAPE_R],
    [-0.3, 0.3, GRAPE_R],
    [0.12, 0.42, GRAPE_R],
    [0.42, -0.16, GRAPE_R],
  ];
  const CYCLE = 7.2;

  interface Joint {
    p: Vec3;
    axis: Vec3;
  }

  function forward(angles: readonly number[]): { joints: Joint[]; points: Vec3[]; ee: Vec3 } {
    let R: Mat3 = IDENTITY;
    let p: Vec3 = [0, 0, 0];
    const joints: Joint[] = [];
    const points: Vec3[] = [p];
    for (let i = 0; i < LINKS.length; i++) {
      const local: Vec3 = AXES[i] === 'z' ? [0, 0, 1] : [0, 1, 0];
      joints.push({ p, axis: norm(applyM(R, local)) });
      R = mul(R, AXES[i] === 'z' ? rotZ(angles[i] ?? 0) : rotY(angles[i] ?? 0));
      const step = applyM(R, [0, 0, LINKS[i] ?? 0]);
      p = [p[0] + step[0], p[1] + step[1], p[2] + step[2]];
      points.push(p);
    }
    return { joints, points, ee: p };
  }

  /** Cyclic coordinate descent onto the target. */
  function solveIK(angles: number[], target: Vec3, iterations: number): void {
    for (let pass = 0; pass < iterations; pass++) {
      for (let i = LINKS.length - 1; i >= 0; i--) {
        const { joints, ee } = forward(angles);
        const j = joints[i];
        if (!j) continue;
        const axis = j.axis;
        const flat = (v: Vec3): Vec3 => {
          const k = dot(v, axis);
          return [v[0] - axis[0] * k, v[1] - axis[1] * k, v[2] - axis[2] * k];
        };
        const a = norm(flat(sub(ee, j.p)));
        const b = norm(flat(sub(target, j.p)));
        if (len3(a) < 1e-6 || len3(b) < 1e-6) continue;
        const signed = Math.atan2(dot(cross(a, b), axis), clamp(dot(a, b), -1, 1));
        const lim = LIMITS[i] ?? [-Math.PI, Math.PI];
        angles[i] = clamp((angles[i] ?? 0) + clamp(signed, -0.25, 0.25), lim[0], lim[1]);
      }
    }
  }

  interface ArmState {
    target: Vec3;
    grape: Vec3;
    grip: number;
    holding: boolean;
  }

  function armScene(t: number): ArmState {
    const cycle = Math.floor(t / CYCLE);
    const u = (t % CYCLE) / CYCLE;
    const spot = SPOTS[cycle % SPOTS.length] ?? SPOTS[0]!;
    const drop: Vec3 = [-0.18, -0.3, GRAPE_R];
    const home: Vec3 = [0.1, 0.05, 0.5];
    const above: Vec3 = [spot[0], spot[1], spot[2] + 0.16];
    const mix = (a: Vec3, b: Vec3, k: number): Vec3 => [
      lerp(a[0], b[0], k),
      lerp(a[1], b[1], k),
      lerp(a[2], b[2], k),
    ];

    if (u < 0.26) return { target: mix(home, above, ease(u / 0.26)), grape: spot, grip: 0, holding: false };
    if (u < 0.4)
      return { target: mix(above, spot, ease((u - 0.26) / 0.14)), grape: spot, grip: 0, holding: false };
    if (u < 0.48) return { target: spot, grape: spot, grip: ease((u - 0.4) / 0.08), holding: false };
    if (u < 0.68) {
      const lifted = mix(spot, above, ease((u - 0.48) / 0.2));
      return { target: lifted, grape: lifted, grip: 1, holding: true };
    }
    if (u < 0.86) {
      const carried = mix(above, [drop[0], drop[1], drop[2] + 0.02], ease((u - 0.68) / 0.18));
      return { target: carried, grape: carried, grip: 1, holding: true };
    }
    const k = ease((u - 0.86) / 0.14);
    return {
      target: mix([drop[0], drop[1], drop[2] + 0.02], home, k),
      grape: drop,
      grip: 1 - k,
      holding: false,
    };
  }

  function tube(ctx: CanvasRenderingContext2D, a: Screen, b: Screen, width: number, tint: number): void {
    const dx = b.x - a.x;
    const dy = b.y - a.y;
    const l = Math.hypot(dx, dy) || 1;
    const nx = (-dy / l) * width * 0.5;
    const ny = (dx / l) * width * 0.5;
    const grad = ctx.createLinearGradient(a.x + nx, a.y + ny, a.x - nx, a.y - ny);
    const base = 150 + tint;
    grad.addColorStop(0, `rgb(${base + 70},${base + 76},${base + 88})`);
    grad.addColorStop(0.45, `rgb(${base},${base + 8},${base + 22})`);
    grad.addColorStop(1, `rgb(${base - 78},${base - 74},${base - 62})`);

    ctx.lineCap = 'round';
    ctx.strokeStyle = 'rgba(8,10,16,0.9)';
    ctx.lineWidth = width + 2.5;
    ctx.beginPath();
    ctx.moveTo(a.x, a.y);
    ctx.lineTo(b.x, b.y);
    ctx.stroke();

    ctx.strokeStyle = grad;
    ctx.lineWidth = width;
    ctx.beginPath();
    ctx.moveTo(a.x, a.y);
    ctx.lineTo(b.x, b.y);
    ctx.stroke();
  }

  function drawArm(
    ctx: CanvasRenderingContext2D,
    cam: Cam,
    angles: readonly number[],
    state: ArmState,
  ): void {
    const { points } = forward(angles);

    ctx.strokeStyle = 'rgba(120,150,215,0.085)';
    ctx.lineWidth = 1;
    const half = 0.6;
    for (let i = -4; i <= 4; i++) {
      const u = (i * half) / 4;
      const a1 = project([u, -half, 0], cam);
      const a2 = project([u, half, 0], cam);
      const b1 = project([-half, u, 0], cam);
      const b2 = project([half, u, 0], cam);
      ctx.beginPath();
      ctx.moveTo(a1.x, a1.y);
      ctx.lineTo(a2.x, a2.y);
      ctx.moveTo(b1.x, b1.y);
      ctx.lineTo(b2.x, b2.y);
      ctx.stroke();
    }

    const shadow = (world: Vec3, radius: number, alpha: number): void => {
      const s = project([world[0], world[1], 0], cam);
      const fade = clamp(1 - world[2] * 0.9, 0.25, 1);
      ctx.fillStyle = `rgba(0,0,0,${(alpha * fade).toFixed(3)})`;
      ctx.beginPath();
      ctx.ellipse(s.x, s.y, radius * s.k * fade, radius * s.k * fade * 0.34, 0, 0, Math.PI * 2);
      ctx.fill();
    };
    const ee = points[points.length - 1];
    if (ee) shadow(ee, 16, 0.35);
    shadow(state.grape, 8, 0.45);

    const base = project([0, 0, 0], cam);
    ctx.fillStyle = 'rgba(120,132,156,0.5)';
    ctx.beginPath();
    ctx.ellipse(base.x, base.y, 20 * base.k, 8 * base.k, 0, 0, Math.PI * 2);
    ctx.fill();

    const screens = points.map((p) => project(p, cam));
    const grapeScreen = project(state.grape, cam);
    const items: { depth: number; paint: () => void }[] = [];

    for (let i = 0; i < screens.length - 1; i++) {
      const a = screens[i];
      const b = screens[i + 1];
      if (!a || !b) continue;
      const k = (a.k + b.k) / 2;
      const width = (15 - i * 1.1) * k;
      items.push({
        depth: (a.depth + b.depth) / 2,
        paint: () => {
          tube(ctx, a, b, width, -i * 6);
          ctx.fillStyle = 'rgba(96,140,240,0.95)';
          ctx.beginPath();
          ctx.arc(a.x, a.y, Math.max(1.7, width * 0.3), 0, Math.PI * 2);
          ctx.fill();
        },
      });
    }

    const wrist = screens[screens.length - 2];
    const tip = screens[screens.length - 1];
    if (wrist && tip) {
      items.push({
        depth: tip.depth,
        paint: () => {
          const dx = tip.x - wrist.x;
          const dy = tip.y - wrist.y;
          const l = Math.hypot(dx, dy) || 1;
          const px = -dy / l;
          const py = dx / l;
          const spread = (1 - state.grip) * 7 * tip.k + 2.6 * tip.k;
          const fl = 9 * tip.k;
          ctx.strokeStyle = 'rgba(226,232,246,0.95)';
          ctx.lineWidth = Math.max(1.4, 3 * tip.k);
          ctx.lineCap = 'round';
          for (const sign of [1, -1]) {
            ctx.beginPath();
            ctx.moveTo(tip.x + px * spread * sign, tip.y + py * spread * sign);
            ctx.lineTo(tip.x + px * spread * sign + (dx / l) * fl, tip.y + py * spread * sign + (dy / l) * fl);
            ctx.stroke();
          }
        },
      });
    }

    items.push({
      // Biased toward the camera while held, or the fingers paint over it.
      depth: grapeScreen.depth - (state.holding ? 0.05 : 0),
      paint: () => {
        const r = Math.max(2.5, GRAPE_R * cam.zoom * grapeScreen.k);
        const g = ctx.createRadialGradient(
          grapeScreen.x - r * 0.35,
          grapeScreen.y - r * 0.4,
          r * 0.1,
          grapeScreen.x,
          grapeScreen.y,
          r * 1.15,
        );
        g.addColorStop(0, '#a86ec8');
        g.addColorStop(0.5, '#6f3f9e');
        g.addColorStop(1, '#3b1f5c');
        ctx.fillStyle = g;
        ctx.beginPath();
        ctx.arc(grapeScreen.x, grapeScreen.y, r, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = 'rgba(255,255,255,0.75)';
        ctx.beginPath();
        ctx.ellipse(grapeScreen.x - r * 0.34, grapeScreen.y - r * 0.42, r * 0.2, r * 0.14, -0.6, 0, Math.PI * 2);
        ctx.fill();
      },
    });

    items.sort((a, b) => b.depth - a.depth);
    for (const item of items) item.paint();
  }

  /* ------------------------------------------------------------- driver -- */

  function start(canvas: HTMLCanvasElement): void {
    const ctx = canvas.getContext('2d', { alpha: false });
    if (!ctx) return;

    const root = canvas.closest('.scene');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const requested = canvas.dataset.mode;
    const mode: 'cars' | 'arm' =
      requested === 'cars' || requested === 'arm'
        ? requested
        : Math.random() < 0.5
          ? 'cars'
          : 'arm';

    if (mode === 'cars') CLOUD = scanStreet();

    const stat = (slot: string, label: string, value: string): void => {
      const dt = root?.querySelector<HTMLElement>(`[data-label="${slot}"]`);
      const dd = root?.querySelector<HTMLElement>(`[data-stat="${slot}"]`);
      if (dt) dt.textContent = label;
      if (dd) dd.textContent = value;
    };

    if (mode === 'cars') {
      stat('a', 'Source', 'LiDAR');
      stat('b', 'Points', (CLOUD?.count ?? 0).toLocaleString('en-GB'));
      stat('c', 'Range', `${MAX_RANGE} m`);
    } else {
      stat('a', 'Source', 'Sim');
      stat('b', 'Joints', '7 DOF');
      stat('c', 'Solver', 'CCD IK');
    }

    let az = mode === 'cars' ? -0.62 : -0.75;
    let el = mode === 'cars' ? 0.44 : 0.4;
    let t = 0;
    let raf = 0;
    let w = 0;
    let h = 0;
    const angles: number[] = [...REST];

    function resize(): void {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      const rect = canvas.getBoundingClientRect();
      w = rect.width;
      h = rect.height;
      canvas.width = Math.max(1, Math.round(w * dpr));
      canvas.height = Math.max(1, Math.round(h * dpr));
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function camera(): Cam {
      // Composed right of centre so the scene doesn't sit under the headline.
      const wide = w > 900;
      return mode === 'cars'
        ? {
            az,
            el,
            zoom: Math.min(w, h) / 15,
            cx: wide ? w * 0.66 : w * 0.5,
            cy: h * 0.58,
            persp: 0.014,
          }
        : {
            az,
            el,
            zoom: Math.min(w, h) * 0.78,
            cx: wide ? w * 0.68 : w * 0.5,
            cy: h * 0.56,
            persp: 0.16,
          };
    }

    function render(): void {
      if (!ctx) return;
      ctx.fillStyle = '#080a10';
      ctx.fillRect(0, 0, w, h);
      const cam = camera();
      if (mode === 'cars') {
        drawCars(ctx, w, h, cam);
      } else {
        solveIK(angles, armScene(t).target, reduced ? 40 : 3);
        drawArm(ctx, cam, angles, armScene(t));
      }
    }

    let dragging = false;
    let lastX = 0;
    let lastY = 0;

    canvas.addEventListener('pointerdown', (e: PointerEvent) => {
      dragging = true;
      lastX = e.clientX;
      lastY = e.clientY;
      canvas.setPointerCapture(e.pointerId);
    });
    canvas.addEventListener('pointermove', (e: PointerEvent) => {
      if (!dragging) return;
      az -= (e.clientX - lastX) * 0.006;
      el = clamp(el + (e.clientY - lastY) * 0.004, 0.04, 1.1);
      lastX = e.clientX;
      lastY = e.clientY;
      if (reduced) render();
    });
    const endDrag = (e: PointerEvent): void => {
      dragging = false;
      if (canvas.hasPointerCapture(e.pointerId)) canvas.releasePointerCapture(e.pointerId);
    };
    canvas.addEventListener('pointerup', endDrag);
    canvas.addEventListener('pointercancel', endDrag);

    resize();
    new ResizeObserver(() => {
      resize();
      render();
    }).observe(canvas);

    if (reduced) {
      t = CYCLE * 0.42;
      render();
      return;
    }

    let last = performance.now();
    const loop = (now: number): void => {
      const dt = Math.min((now - last) / 1000, 0.05);
      last = now;
      t += dt;
      if (!dragging) az -= dt * (mode === 'cars' ? 0.05 : 0.07);
      render();
      raf = requestAnimationFrame(loop);
    };
    raf = requestAnimationFrame(loop);

    new IntersectionObserver((entries) => {
      const visible = entries[0]?.isIntersecting ?? false;
      if (visible && !raf) {
        last = performance.now();
        raf = requestAnimationFrame(loop);
      } else if (!visible && raf) {
        cancelAnimationFrame(raf);
        raf = 0;
      }
    }).observe(canvas);
  }

  document.querySelectorAll<HTMLCanvasElement>('canvas[data-hero-scene]').forEach(start);
</script>
