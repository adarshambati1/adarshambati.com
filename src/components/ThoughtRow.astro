---
import type { Thought } from '../lib/site';
import { formatDate } from '../lib/site';

/** One thought entry in a listing. */
interface Props {
  entry: Thought;
}

const { entry } = Astro.props;
const { title, date, summary, tags } = entry.data;
---

<article class="note">
  <div class="note__head">
    <h3 class="note__title">
      <a class="note__link" href={`/thoughts/${entry.id}`}>{title}</a>
    </h3>
    <time class="note__date u-mono-nums" datetime={date.toISOString()}>{formatDate(date)}</time>
  </div>

  {summary && <p class="note__summary">{summary}</p>}

  {
    tags.length > 0 && (
      <ul class="note__tags">
        {tags.map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .note {
    position: relative;
    padding: var(--space-4) 0;
    border-top: 1px solid var(--color-border);
  }

  .note:last-of-type {
    border-bottom: 1px solid var(--color-border);
  }

  .note::before {
    content: '';
    position: absolute;
    inset: 0 calc(var(--space-4) * -1);
    border-radius: var(--radius-md);
    background: transparent;
    transition: background var(--transition);
    z-index: -1;
  }

  .note:hover::before {
    background: var(--color-bg-subtle);
  }

  .note__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .note__title {
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
  }

  .note__link {
    text-decoration: none;
  }

  .note__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .note:hover .note__title {
    color: var(--color-accent);
  }

  .note__date {
    flex: none;
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }

  .note__summary {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .note__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .note__tags li {
    padding: 0.1rem 0.45rem;
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    background: var(--color-surface);
    border-radius: var(--radius-sm);
  }
</style>
