---
import HeroScene from './HeroScene.astro';

/**
 * Full-viewport dark hero.
 *
 * The 3D scene fills the whole hero and the text sits on top of it — no split,
 * no divider. A left-weighted scrim keeps the copy legible over whatever the
 * scene happens to be doing behind it, without dimming the whole frame.
 */
export interface Credential {
  readonly text: string;
  readonly href?: string | undefined;
}

export interface HeroLink {
  readonly label: string;
  readonly href: string;
  readonly icon: 'linkedin' | 'github' | 'email';
}

interface Props {
  name: string;
  eyebrow?: string;
  tagline: string;
  location?: string;
  credentials?: readonly Credential[];
  links?: readonly HeroLink[];
  /** Pin the scene instead of choosing at random. */
  scene?: 'auto' | 'scan' | 'arm';
}

const {
  name,
  eyebrow = '',
  tagline,
  location = '',
  credentials = [],
  links = [],
  scene = 'auto',
} = Astro.props;
---

<section class="hero">
  <HeroScene mode={scene} />
  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="hero__inner">
    <div class="hero__text">
      {eyebrow && <p class="hero__eyebrow">{eyebrow}</p>}

      <h1 class="hero__name">{name}</h1>
      <p class="hero__role">{tagline}</p>
      {location && <p class="hero__location">{location}</p>}

      {
        credentials.length > 0 && (
          <p class="hero__creds">
            {credentials.map((c) => (
              <>
                {c.href ? (
                  <a class="hero__cred-link" href={c.href} rel="noopener">
                    {c.text}
                  </a>
                ) : (
                  <span>{c.text}</span>
                )}{' '}
              </>
            ))}
          </p>
        )
      }

      {
        links.length > 0 && (
          <ul class="hero__links">
            {links.map((link) => (
              <li>
                <a class="hero__icon" href={link.href} rel="me noopener" aria-label={link.label}>
                  {link.icon === 'linkedin' && (
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.5 4.78 5.76V21h-4v-5.5c0-1.31-.03-3-1.9-3-1.9 0-2.2 1.42-2.2 2.9V21H9z" />
                    </svg>
                  )}
                  {link.icon === 'github' && (
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2z" />
                    </svg>
                  )}
                  {link.icon === 'email' && (
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M2 5.5A1.5 1.5 0 0 1 3.5 4h17A1.5 1.5 0 0 1 22 5.5v.4l-10 5.8-10-5.8zM2 8.2V18.5A1.5 1.5 0 0 0 3.5 20h17a1.5 1.5 0 0 0 1.5-1.5V8.2l-9.5 5.5a1 1 0 0 1-1 0z" />
                    </svg>
                  )}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>

</section>

<style>
  .hero {
    position: relative;
    /* dvh so mobile browser chrome doesn't crop the bottom. */
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    background: #080a10;
    color: #f2f4fa;
    overflow: hidden;
  }

  /* Weighted to the left, and only as far as the text runs — the scene stays
     fully visible on the right where it's composed. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(
        100deg,
        rgba(8, 10, 16, 0.94) 0%,
        rgba(8, 10, 16, 0.86) 26%,
        rgba(8, 10, 16, 0.45) 48%,
        rgba(8, 10, 16, 0) 68%
      ),
      linear-gradient(to bottom, rgba(8, 10, 16, 0.6) 0%, rgba(8, 10, 16, 0) 22%);
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 76rem;
    margin: 0 auto;
    padding: var(--header-height) var(--space-6) var(--space-8);
    /* The scene owns the pointer for dragging; only the copy takes clicks. */
    pointer-events: none;
  }

  .hero__text {
    max-width: 34rem;
  }

  .hero__text a {
    pointer-events: auto;
  }

  .hero__eyebrow {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: 0.02em;
    color: #8ea0c8;
    margin-bottom: var(--space-3);
  }

  .hero__name {
    font-size: clamp(3rem, 7.5vw, 5.25rem);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.04em;
    line-height: 0.98;
    color: #fff;
  }

  .hero__role {
    margin-top: var(--space-3);
    font-size: clamp(1.15rem, 2.2vw, 1.6rem);
    color: #b9c4dc;
    letter-spacing: -0.015em;
  }

  .hero__location {
    margin-top: var(--space-1);
    font-size: var(--text-base);
    color: #7e8caa;
  }

  .hero__creds {
    max-width: 30rem;
    margin-top: var(--space-5);
    font-size: var(--text-sm);
    line-height: 1.6;
    color: #9aa7c4;
  }

  .hero__cred-link {
    color: #9db4ff;
    text-decoration: none;
  }

  .hero__cred-link:hover {
    color: #c3d1ff;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .hero__links {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-6);
    padding: 0;
    list-style: none;
  }

  .hero__icon {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    color: #dbe3f5;
    border: 1px solid rgba(219, 227, 245, 0.32);
    border-radius: 50%;
    background: rgba(8, 10, 16, 0.4);
    text-decoration: none;
    transition: background var(--transition), border-color var(--transition), color var(--transition);
  }

  .hero__icon svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .hero__icon:hover {
    color: #08090d;
    background: #dbe3f5;
    border-color: #dbe3f5;
  }

  @media (max-width: 52rem) {
    .hero__inner {
      padding-top: calc(var(--header-height) + var(--space-6));
    }
    .hero__scrim {
      background:
        linear-gradient(to bottom, rgba(8, 10, 16, 0.92) 0%, rgba(8, 10, 16, 0.75) 52%, rgba(8, 10, 16, 0.25) 100%);
    }
  }
</style>
