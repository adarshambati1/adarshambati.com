{
  "name": "adarsh-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/astro/bin/astro.mjs dev",
    "build": "node --env-file-if-exists=.env node_modules/astro/bin/astro.mjs build",
    "check": "astro check",
    "icons": "node scripts/make-icons.mjs",
    "preview": "node --env-file-if-exists=.env node_modules/astro/bin/astro.mjs preview",
    "verify": "astro check && astro build"
  },
  "dependencies": {
    "@astrojs/vercel": "^11.0.5",
    "@fontsource-variable/inter": "^5.3.0",
    "@libsql/client": "^0.17.4",
    "astro": "^7.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
